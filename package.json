{
  "name": "personal-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "build": "astro build",
    "preview": "astro preview",
    "pdf:build": "node scripts/build-resume-pdf.mjs",
    "pdf:verify": "node scripts/verify-pdf.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:budgets": "node scripts/verify-budgets.mjs",
    "test:e2e": "playwright test",
    "verify:all": "pnpm check && pnpm lint && pnpm test:unit && pnpm build && pnpm pdf:build && pnpm pdf:verify && pnpm verify:content && pnpm verify:budgets && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.7.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "three": "0.185.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.14.0",
    "@types/three": "0.185.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "pdf-parse": "^1.1.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.0"
  }
}
