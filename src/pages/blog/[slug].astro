---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import CopyCodeEnhancer from '@/components/CopyCodeEnhancer.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
import { SITE, withBase } from '@/data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => p.data.published);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const slug = post.id.replace(/\.mdx$/, '');
const { Content, headings } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — ${SITE.name}`}
  description={post.data.summary}
  canonicalPath={`/blog/${slug}/`}
  ogType="article"
>
  <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs text-muted">
    <a href={withBase('/blog/')} class="text-tech underline-offset-4 hover:underline">
      &larr; Back to Blog
    </a>
  </nav>

  <header class="mb-8 border-b border-hairline pb-6">
    <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
      <time datetime={post.data.publishedAt.toISOString()} class="tabular-nums">
        {post.data.publishedAt.toISOString().slice(0, 10)}
      </time>
      <span>&middot;</span>
      <span>{post.data.readingTime}</span>
    </div>
    <h1 class="mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">
      {post.data.title}
    </h1>
    <p class="mt-3 max-w-2xl text-base text-ink-secondary">{post.data.summary}</p>
  </header>

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_240px]">
    <article class="prose-tech">
      <Content />
    </article>
    <TableOfContents headings={headings} />
  </div>

  <div class="mt-12">
    <SubscribeForm />
  </div>

  <CopyCodeEnhancer />
</BaseLayout>
