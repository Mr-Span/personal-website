---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
import { SITE, withBase } from '@/data/site';

const publishedPosts = (await getCollection('blog'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const allTags = Array.from(
  new Set(publishedPosts.flatMap((post) => post.data.tags)),
).sort();
---

<BaseLayout
  title={`Engineering Notes & Blog — ${SITE.name}`}
  description="Technical write-ups, architecture trade-offs, Applied AI notes, and tutorials by Claudiu Șpan."
  canonicalPath="/blog/"
  includeMonoFont
>
  <header class="mb-8 border-b border-border-subtle pb-6">
    <p class="font-mono text-xs uppercase tracking-wider text-baby">Engineering Notes &amp; Tutorials</p>
    <h1 class="mt-1 font-display text-3xl font-bold text-ink sm:text-4xl">Technical Blog</h1>
    <p class="mt-2 max-w-2xl text-sm text-muted sm:text-base">
      Deep dives on enterprise Agentic AI, PII-safe orchestration, RAG evaluation, and cyber-physical robotics experiments.
    </p>

    {allTags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filter articles by tag">
        <button
          type="button"
          data-tag-filter="all"
          aria-pressed="true"
          class="min-h-[36px] rounded-lg border border-baby bg-baby px-3 text-xs font-semibold text-[var(--accent-on-primary)]"
        >
          All
        </button>
        {allTags.map((tag) => (
          <button
            type="button"
            data-tag-filter={tag}
            aria-pressed="false"
            class="min-h-[36px] rounded-lg border border-border-strong bg-surface px-3 text-xs font-semibold text-muted hover:border-baby hover:text-ink"
          >
            {tag}
          </button>
        ))}
      </div>
    )}
  </header>

  {publishedPosts.length > 0 ? (
    <div class="mb-10 grid grid-cols-1 gap-5 md:grid-cols-2">
      {publishedPosts.map((post) => {
        const slug = post.id.replace(/\.mdx$/, '');
        return (
          <article
            class="bento-card bento-card-interactive flex flex-col justify-between gap-4 p-5"
            data-post-card
            data-tags={post.data.tags.join(' ')}
          >
            <div>
              <div class="flex items-center justify-between gap-2 font-mono text-xs text-muted">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toISOString().slice(0, 10)}
                </time>
                <span>{post.data.readingTime}</span>
              </div>
              <h2 class="mt-2 font-display text-xl font-bold text-ink">
                <a href={withBase(`/blog/${slug}/`)} class="hover:text-baby">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm text-muted">{post.data.summary}</p>
            </div>

            <div class="flex flex-wrap gap-1.5 border-t border-border-subtle pt-3">
              {post.data.tags.map((tag) => (
                <span class="rounded border border-border-subtle bg-elevated px-2 py-0.5 font-mono text-xs text-baby">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <section class="bento-card mb-8 p-6" aria-label="Upcoming engineering notes">
      <p class="font-mono text-xs uppercase tracking-wider text-signal">First Notes In Preparation</p>
      <h2 class="mt-1.5 font-display text-xl font-bold text-ink">
        Technical articles are being prepared for publication
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-muted">
        In the meantime, explore the interactive system architecture case studies on{' '}
        <a href={withBase('/projects/')} class="font-medium text-baby underline underline-offset-4">
          /projects
        </a>{' '}
        or subscribe below to get notified via email or RSS when the first engineering notes drop.
      </p>
    </section>
  )}

  <SubscribeForm />

  {allTags.length > 0 && (
    <script is:inline>
      (() => {
        const btns = Array.from(document.querySelectorAll('[data-tag-filter]'));
        const cards = Array.from(document.querySelectorAll('[data-post-card]'));
        function filter(tag) {
          for (const card of cards) {
            const tags = (card.getAttribute('data-tags') || '').split(/\s+/);
            card.hidden = !(tag === 'all' || tags.includes(tag));
          }
          for (const btn of btns) {
            const active = btn.getAttribute('data-tag-filter') === tag;
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          }
        }
        for (const btn of btns) {
          btn.addEventListener('click', () => {
            filter(btn.getAttribute('data-tag-filter') || 'all');
          });
        }
      })();
    </script>
  )}
</BaseLayout>
