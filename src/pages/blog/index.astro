---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
import { SITE, withBase } from '@/data/site';

const publishedPosts = (await getCollection('blog'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const allTags = Array.from(
  new Set(publishedPosts.flatMap((post) => post.data.tags)),
).sort();
---

<BaseLayout
  title={`Notes & Engineering Blog — ${SITE.name}`}
  description="Engineering notes on enterprise Agentic AI, PII-safe orchestration, RAG evaluation, and cyber-physical robotics by Claudiu Șpan."
  canonicalPath="/blog/"
>
  <header class="pb-8">
    <h1 class="font-display text-3xl font-bold tracking-[-0.03em] text-ink sm:text-4xl">
      {publishedPosts.length > 0 ? 'Technical Blog' : 'Notes'}
    </h1>
    <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-ink-secondary sm:text-base">
      Engineering notes on enterprise Agentic AI, PII-safe orchestration, RAG evaluation, and cyber-physical robotics.
    </p>

    {allTags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Filter articles by tag">
        <button type="button" data-tag-filter="all" aria-pressed="true" class="filter-tab">
          All
        </button>
        {allTags.map((tag) => (
          <button type="button" data-tag-filter={tag} aria-pressed="false" class="filter-tab">
            {tag}
          </button>
        ))}
      </div>
    )}
  </header>

  {publishedPosts.length > 0 && (
    <div class="swiss-dim-list mb-10 border-t border-hairline">
      {publishedPosts.map((post) => {
        const slug = post.id.replace(/\.mdx$/, '');
        return (
          <article
            class="swiss-dim-item border-b border-hairline py-6"
            data-post-card
            data-tags={post.data.tags.join('|')}
          >
            <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-muted">
              <time datetime={post.data.publishedAt.toISOString()} class="tabular-nums">
                {post.data.publishedAt.toISOString().slice(0, 10)}
              </time>
              <span>{post.data.readingTime}</span>
            </div>
            <h2 class="dim-title mt-2 font-display text-xl font-bold tracking-[-0.025em] text-ink">
              <a href={withBase(`/blog/${slug}/`)} class="underline-offset-4 transition-colors hover:text-tech hover:underline">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-secondary">{post.data.summary}</p>
            <p class="mt-3 font-mono text-xs text-muted">
              {post.data.tags.join(' · ')}
            </p>
          </article>
        );
      })}
    </div>
  )}

  <SubscribeForm />

  {allTags.length > 0 && (
    <script is:inline>
      (() => {
        const btns = Array.from(document.querySelectorAll('[data-tag-filter]'));
        const cards = Array.from(document.querySelectorAll('[data-post-card]'));
        function filter(tag) {
          for (const card of cards) {
            const tags = (card.getAttribute('data-tags') || '').split('|').filter(Boolean);
            card.hidden = !(tag === 'all' || tags.includes(tag));
          }
          for (const btn of btns) {
            const active = btn.getAttribute('data-tag-filter') === tag;
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          }
        }
        for (const btn of btns) {
          btn.addEventListener('click', () => {
            filter(btn.getAttribute('data-tag-filter') || 'all');
          });
        }
      })();
    </script>
  )}
</BaseLayout>
