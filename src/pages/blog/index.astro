---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
import { SITE, withBase } from '@/data/site';

const publishedPosts = (await getCollection('blog'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const allTags = Array.from(
  new Set(publishedPosts.flatMap((post) => post.data.tags)),
).sort();
---

<BaseLayout
  title={`Engineering Notes & Blog — ${SITE.name}`}
  description="Technical write-ups, architecture trade-offs, Applied AI notes, and tutorials by Claudiu Șpan."
  canonicalPath="/blog/"
>
  <header class="hw-panel mb-8 p-6 sm:p-8">
    <p class="hw-eyebrow text-vermilion">
      <span class="px-beacon" aria-hidden="true"></span>
      <span>Engineering Notes &amp; Tutorials</span>
    </p>
    <h1 class="mt-2.5 font-display text-3xl font-bold tracking-[-0.03em] text-ink sm:text-4xl">Technical Blog</h1>
    <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-ink-secondary sm:text-base">
      Deep dives on enterprise Agentic AI, PII-safe orchestration, RAG evaluation, and cyber-physical robotics experiments.
    </p>

    {allTags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Filter articles by tag">
        <button type="button" data-tag-filter="all" aria-pressed="true" class="filter-tab">
          All
        </button>
        {allTags.map((tag) => (
          <button type="button" data-tag-filter={tag} aria-pressed="false" class="filter-tab">
            {tag}
          </button>
        ))}
      </div>
    )}
  </header>

  {publishedPosts.length > 0 ? (
    <div class="swiss-dim-list mb-10 space-y-3.5">
      {publishedPosts.map((post) => {
        const slug = post.id.replace(/\.mdx$/, '');
        return (
          <article
            class="swiss-dim-item hw-cell p-5 hover:-translate-y-0.5 sm:p-6"
            data-post-card
            data-tags={post.data.tags.join(' ')}
          >
            <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs text-muted">
              <time datetime={post.data.publishedAt.toISOString()} class="tabular-nums">
                {post.data.publishedAt.toISOString().slice(0, 10)}
              </time>
              <span>{post.data.readingTime}</span>
            </div>
            <h2 class="dim-title mt-2 font-display text-xl font-bold tracking-[-0.025em] text-ink">
              <a href={withBase(`/blog/${slug}/`)} class="underline-offset-4 transition-colors hover:text-tech hover:underline">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-secondary">{post.data.summary}</p>
            <p class="mt-3 border-t border-hairline pt-2.5 font-mono text-xs text-muted">
              {post.data.tags.join(' · ')}
            </p>
          </article>
        );
      })}
    </div>
  ) : (
    <section class="hw-panel mb-8 p-6 sm:p-7" aria-label="Upcoming engineering notes">
      <p class="hw-eyebrow text-signal">
        <span class="px-beacon px-beacon-signal" aria-hidden="true"></span>
        <span>First Notes In Preparation</span>
      </p>
      <h2 class="mt-2.5 font-display text-xl font-semibold tracking-[-0.025em] text-ink">
        Technical articles are being prepared for publication
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-secondary">
        In the meantime, explore the interactive system architecture case studies on{' '}
        <a href={withBase('/projects/')} class="font-semibold text-tech underline underline-offset-4">
          /projects
        </a>{' '}
        or subscribe below to get notified via email or RSS when the first engineering notes drop.
      </p>
    </section>
  )}

  <div class="blog-subscribe-frame">
    <SubscribeForm />
  </div>

  <style>
    .blog-subscribe-frame :global([data-subscribe-widget]) {
      border-radius: 12px;
      border-color: var(--border-strong);
      background: linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg-surface) 100%);
      box-shadow: var(--shadow-card);
    }

    .blog-subscribe-frame :global(#subscribe-email) {
      border-radius: 10px;
      border-color: var(--border-strong);
      background: var(--bg-canvas);
      box-shadow: var(--shadow-bevel);
    }

    .blog-subscribe-frame :global(#subscribe-submit) {
      border-radius: 10px;
      background: var(--cta-bg);
      background-color: #B33D0E;
      color: #FAF8F5;
      border: 1px solid var(--cta-border);
      box-shadow: var(--cta-shadow);
    }

    .blog-subscribe-frame :global(#subscribe-submit:hover) {
      filter: brightness(1.07);
    }
  </style>

  {allTags.length > 0 && (
    <script is:inline>
      (() => {
        const btns = Array.from(document.querySelectorAll('[data-tag-filter]'));
        const cards = Array.from(document.querySelectorAll('[data-post-card]'));
        function filter(tag) {
          for (const card of cards) {
            const tags = (card.getAttribute('data-tags') || '').split(/\s+/);
            card.hidden = !(tag === 'all' || tags.includes(tag));
          }
          for (const btn of btns) {
            const active = btn.getAttribute('data-tag-filter') === tag;
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          }
        }
        for (const btn of btns) {
          btn.addEventListener('click', () => {
            filter(btn.getAttribute('data-tag-filter') || 'all');
          });
        }
      })();
    </script>
  )}
</BaseLayout>
