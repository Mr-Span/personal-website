---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, withBase } from '@/data/site';
---

<BaseLayout
  title={`Page Not Found — ${SITE.name}`}
  description="The requested page could not be found. Navigate to Home, Projects, or Resume."
  canonicalPath="/404.html"
>
  <section class="bento-card mx-auto my-12 max-w-xl p-8 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-coral">404 · Not Found</p>
    <h1 class="mt-2 font-display text-3xl font-bold text-ink">Page not found</h1>
    <p class="mt-3 text-sm text-muted">
      The link may be outdated after upgrading to v2.0. Jump straight to the main sections below.
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href={withBase('/')}
        class="inline-flex min-h-[44px] items-center rounded-lg bg-baby px-5 text-sm font-semibold text-[var(--accent-on-primary)]"
      >
        Home
      </a>
      <a
        href={withBase('/projects/')}
        class="inline-flex min-h-[44px] items-center rounded-lg border border-border-strong bg-elevated px-4 text-sm font-semibold text-ink hover:border-baby"
      >
        Projects
      </a>
      <a
        href={withBase('/resume/')}
        class="inline-flex min-h-[44px] items-center rounded-lg border border-border-strong bg-elevated px-4 text-sm font-semibold text-ink hover:border-baby"
      >
        Resume
      </a>
    </div>
  </section>
</BaseLayout>
