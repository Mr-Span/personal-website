---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, withBase } from '@/data/site';
---

<BaseLayout
  title={`Page Not Found — ${SITE.name}`}
  description="The requested page could not be found. Navigate to Home, Projects, or Resume."
  canonicalPath="/404.html"
>
  <section class="hw-panel mx-auto my-12 max-w-xl p-8 text-center">
    <p class="hw-eyebrow text-vermilion">
      <span class="px-beacon" aria-hidden="true"></span>
      <span>404</span>
      <span class="px-sep" aria-hidden="true"></span>
      <span>Not Found</span>
    </p>
    <h1 class="mt-3 font-display text-3xl font-semibold tracking-[-0.03em] text-ink">Page not found</h1>
    <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
      The requested route does not exist or moved during the portfolio upgrade. Jump directly to the main sections below.
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
      <a href={withBase('/')} class="cta-anodized btn-press">
        Home
      </a>
      <a href={withBase('/projects/')} class="cta-secondary-bevel btn-press">
        Projects
      </a>
      <a href={withBase('/resume/')} class="cta-secondary-bevel btn-press">
        Resume
      </a>
    </div>
  </section>
</BaseLayout>
