---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, withBase } from '@/data/site';

const basePrefix = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
---

<BaseLayout
  title={`Page Not Found — ${SITE.name}`}
  description="The requested page could not be found. Navigate to Home or Blog."
  canonicalPath="/404.html"
>
  <section class="mx-auto my-16 max-w-xl border-y border-hairline py-10 text-center">
    <p class="inline-flex items-center justify-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-vermilion">
      <span class="px-beacon" aria-hidden="true"></span>
      <span>404</span>
      <span class="px-sep" aria-hidden="true"></span>
      <span>Not Found</span>
    </p>
    <h1 class="mt-3 font-display text-3xl font-semibold tracking-[-0.03em] text-ink">Page not found</h1>
    <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
      The requested route does not exist or moved to the single-page portfolio.
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
      <a href={withBase('/')} class="cta-anodized btn-press">
        Home
      </a>
      <a href={withBase('/blog/')} class="cta-secondary-bevel btn-press">
        Blog
      </a>
    </div>
  </section>

  <script is:inline define:vars={{ basePrefix }}>
    (() => {
      const base = basePrefix || '';
      let path = window.location.pathname;
      if (base && path.startsWith(base)) {
        path = path.slice(base.length);
      }
      path = path.replace(/\/index\.html$/i, '').replace(/\/+$/, '') || '/';
      const redirects = {
        '/resume': '/#experience',
        '/projects/quadyx-autonomy': '/#proj-quadyx',
        '/projects/enterprise-agentic-review': '/#proj-flutter',
        '/projects/electrocasnicu-rag': '/#proj-electrocasnicu',
        '/projects/agri-rover': '/#proj-agri-rover',
        '/projects': '/#projects',
      };
      const target = redirects[path] || (path.startsWith('/projects/') ? '/#projects' : null);
      if (target) {
        window.location.replace(base + target);
      }
    })();
  </script>
</BaseLayout>
