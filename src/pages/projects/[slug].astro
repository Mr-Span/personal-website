---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchitectureVisualizer from '@/components/diagram/ArchitectureVisualizer';
import { SITE, withBase } from '@/data/site';
import { loadCompiledArchitecture } from '@/lib/architecture-loader';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.tier === 'case-study')
    .map((project) => ({
      params: { slug: project.id.replace(/\.mdx$/, '') },
      props: { project },
    }));
}

const { project } = Astro.props;
const slug = project.id.replace(/\.mdx$/, '');
const { Content } = await render(project);
const compiledGraph = project.data.architectureFile
  ? loadCompiledArchitecture(project.data.architectureFile)
  : null;
---

<BaseLayout
  title={`${project.data.title} — ${SITE.name}`}
  description={project.data.summary}
  canonicalPath={`/projects/${slug}/`}
  ogType="article"
  includeMonoFont
>
  <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
    <a href={withBase('/projects/')} class="text-baby underline-offset-4 hover:underline">
      &larr; Back to Projects
    </a>
  </nav>

  <header class="mb-8 space-y-4 border-b border-border-subtle pb-6">
    <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono">
      <span class="rounded border border-border-strong bg-elevated px-2.5 py-1 text-baby">
        {project.data.isSideVenture ? 'Technical Side Venture' : 'Tier 1 Engineering Case Study'}
      </span>
      <span class="rounded border border-border-subtle bg-surface px-2.5 py-1 text-coral font-semibold">
        {project.data.outcomeBadge}
      </span>
    </div>

    <h1 class="font-display text-3xl font-bold text-ink sm:text-4xl">
      {project.data.title}
    </h1>

    <p class="max-w-3xl text-base text-muted">{project.data.summary}</p>

    {project.data.anonymizationNote && (
      <p class="rounded-lg border border-border-strong bg-elevated/70 px-4 py-3 text-xs text-muted">
        <strong class="font-mono uppercase text-ink">Confidentiality Notice:</strong>{' '}
        {project.data.anonymizationNote}
      </p>
    )}

    <div class="flex flex-wrap items-center gap-3 pt-1">
      {project.data.visibility === 'public' && project.data.repoUrl && (
        <a
          href={project.data.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[40px] items-center gap-1.5 rounded-lg bg-baby px-4 text-xs font-semibold text-[var(--accent-on-primary)] transition-opacity hover:opacity-90"
        >
          View Source Repository &#8599;
        </a>
      )}
      {project.data.liveUrl && (
        <a
          href={project.data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[40px] items-center gap-1.5 rounded-lg border border-border-strong bg-surface px-4 text-xs font-semibold text-ink transition-colors hover:border-baby hover:text-baby"
        >
          Visit Live Project &#8599;
        </a>
      )}
    </div>
  </header>

  {compiledGraph && (
    <div class="mb-10">
      <ArchitectureVisualizer client:visible graph={compiledGraph} />
    </div>
  )}

  <article class="prose-tech">
    <Content />
  </article>
</BaseLayout>
