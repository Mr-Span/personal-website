---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchitectureVisualizer from '@/components/diagram/ArchitectureVisualizer';
import { SITE, withBase } from '@/data/site';
import { loadCompiledArchitecture } from '@/lib/architecture-loader';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.tier === 'case-study')
    .map((project) => ({
      params: { slug: project.id.replace(/\.mdx$/, '') },
      props: { project },
    }));
}

const { project } = Astro.props;
const slug = project.id.replace(/\.mdx$/, '');
const { Content } = await render(project);
const compiledGraph = project.data.architectureFile
  ? loadCompiledArchitecture(project.data.architectureFile)
  : null;
---

<BaseLayout
  title={`${project.data.title} — ${SITE.name}`}
  description={project.data.summary}
  canonicalPath={`/projects/${slug}/`}
  ogType="article"
>
  <nav aria-label="Breadcrumb" class="mb-6">
    <a href={withBase('/projects/')} class="cta-secondary-bevel btn-press font-mono text-xs">
      &larr; Back to Projects
    </a>
  </nav>

  <header class="hw-panel mb-8 space-y-4 p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-2.5 font-mono text-xs">
      <span class="hw-eyebrow">
        <span class="px-beacon" aria-hidden="true"></span>
        <span>{project.data.isSideVenture ? 'Technical Side Venture' : 'Engineering Case Study'}</span>
      </span>
      <span class="px-sep" aria-hidden="true"></span>
      <span class="font-medium text-vermilion tabular-nums">
        {project.data.outcomeBadge}
      </span>
    </div>

    <h1 class="font-display text-3xl font-bold tracking-[-0.03em] text-ink sm:text-4xl">
      {project.data.title}
    </h1>

    <p class="max-w-3xl text-base leading-relaxed text-ink-secondary">{project.data.summary}</p>

    <p class="font-mono text-xs text-muted">
      Stack: {project.data.stack.join(' · ')}
    </p>

    {project.data.anonymizationNote && (
      <p class="rounded-[10px] border border-hairline border-l-[3px] border-l-vermilion bg-recessed/80 px-4 py-3 text-xs leading-relaxed text-ink-secondary">
        <strong class="font-mono uppercase text-ink">Confidentiality Notice:</strong>{' '}
        {project.data.anonymizationNote}
      </p>
    )}

    {(project.data.liveUrl || (project.data.visibility === 'public' && project.data.repoUrl)) && (
      <div class="flex flex-wrap items-center gap-3 pt-1">
        {project.data.visibility === 'public' && project.data.repoUrl && (
          <a
            href={project.data.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-anodized btn-press"
          >
            View Source Repository &#8599;
          </a>
        )}
        {project.data.liveUrl && (
          <a
            href={project.data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-secondary-bevel btn-press"
          >
            Visit Live Project &#8599;
          </a>
        )}
      </div>
    )}
  </header>

  {compiledGraph && (
    <div class="mb-10">
      <ArchitectureVisualizer client:visible graph={compiledGraph} />
    </div>
  )}

  <article class="hw-panel p-6 sm:p-10">
    <div class="prose-tech">
      <Content />
    </div>
  </article>
</BaseLayout>
