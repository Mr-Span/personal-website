---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { SITE } from '@/data/site';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const caseStudies = allProjects.filter((p) => p.data.tier === 'case-study');
const showcaseCards = allProjects.filter((p) => p.data.tier === 'showcase-card');

const filters = [
  { id: 'all', label: 'All' },
  { id: 'ai', label: 'Applied AI' },
  { id: 'automation', label: 'Automation & RPA' },
  { id: 'robotics', label: 'Robotics (Side Venture)' },
  { id: 'client-web', label: 'Client Websites' },
];
---

<BaseLayout
  title={`Projects & Architectures — ${SITE.name}`}
  description="Interactive system architecture case studies (Enterprise Agentic AI, Document RAG, UAV Autonomy) and public/client software engineering work by Claudiu Șpan."
  canonicalPath="/projects/"
  includeMonoFont
>
  <header class="mb-8 flex flex-col gap-4 border-b border-border-subtle pb-6 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-wider text-baby">Portfolio &amp; Case Studies</p>
      <h1 class="mt-1 font-display text-3xl font-bold text-ink sm:text-4xl">
        Production Systems, Agentic AI &amp; Client Work
      </h1>
      <p class="mt-2 text-sm text-muted sm:text-base">
        Tier 1 case studies include interactive SVG architecture diagrams with Nominal and Guardrail/Failure modes. Private client repositories never expose dead GitHub links.
      </p>
    </div>

    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects by category">
      {filters.map((f) => (
        <button
          type="button"
          data-filter={f.id}
          aria-pressed={f.id === 'all' ? 'true' : 'false'}
          class:list={[
            'min-h-[40px] rounded-lg border px-3.5 text-xs font-semibold transition-colors',
            f.id === 'all'
              ? 'border-baby bg-baby text-[var(--accent-on-primary)]'
              : 'border-border-strong bg-surface text-muted hover:border-baby hover:text-ink',
          ]}
        >
          {f.label}
        </button>
      ))}
    </div>
  </header>

  <p id="filter-status" class="sr-only" aria-live="polite"></p>

  <section aria-labelledby="tier1-heading" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 id="tier1-heading" class="font-display text-xl font-bold text-ink">
        Flagship Case Studies &amp; Interactive Architectures
      </h2>
      <span class="font-mono text-xs text-muted">{caseStudies.length} deep dives</span>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {caseStudies.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section aria-labelledby="tier2-heading" class="mt-12 space-y-4">
    <div class="flex items-center justify-between">
      <h2 id="tier2-heading" class="font-display text-xl font-bold text-ink">
        Additional Tools &amp; Client Websites
      </h2>
      <span class="font-mono text-xs text-muted">{showcaseCards.length} projects</span>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-2">
      {showcaseCards.map((project) => (
        <ProjectCard project={project} compact />
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const buttons = Array.from(document.querySelectorAll('[data-filter]'));
      const cards = Array.from(document.querySelectorAll('[data-project-card]'));
      const status = document.getElementById('filter-status');

      function applyFilter(category, syncUrl) {
        let visibleCount = 0;
        for (const card of cards) {
          const cats = (card.getAttribute('data-categories') || '').split(/\s+/);
          const match = category === 'all' || cats.includes(category);
          card.hidden = !match;
          if (match) visibleCount += 1;
        }

        for (const btn of buttons) {
          const active = btn.getAttribute('data-filter') === category;
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          btn.className = active
            ? 'min-h-[40px] rounded-lg border border-baby bg-baby px-3.5 text-xs font-semibold text-[var(--accent-on-primary)] transition-colors'
            : 'min-h-[40px] rounded-lg border border-border-strong bg-surface px-3.5 text-xs font-semibold text-muted transition-colors hover:border-baby hover:text-ink';
        }

        if (status) {
          status.textContent = `Showing ${visibleCount} project(s) for category ${category}.`;
        }

        if (syncUrl && window.history && window.history.replaceState) {
          const url = new URL(window.location.href);
          if (category === 'all') url.searchParams.delete('category');
          else url.searchParams.set('category', category);
          window.history.replaceState({}, '', url.toString());
        }
      }

      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-filter') || 'all', true);
        });
      }

      const initial = new URLSearchParams(window.location.search).get('category');
      if (initial && ['all', 'ai', 'automation', 'robotics', 'client-web'].includes(initial)) {
        applyFilter(initial, false);
      }
    })();
  </script>
</BaseLayout>
