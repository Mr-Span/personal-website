---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import KinematicHero from '@/components/KinematicHero.astro';
import ModulePreviewDialog from '@/components/ModulePreviewDialog.astro';
import PersonalBadgeDialog from '@/components/PersonalBadgeDialog.astro';
import VerticalCncRail from '@/components/VerticalCncRail.astro';
import ProjectPixelVisual from '@/components/ProjectPixelVisual.astro';
import CertificationCarousel from '@/components/CertificationCarousel.astro';
import CertificationGrid from '@/components/CertificationGrid.astro';
import {
  buildShowcaseModules,
  GRADUATION_CAP_GRID,
  GRADUATION_TASSEL_RECTS,
  PIXEL_GLYPHS,
} from '@/data/showcase-modules';
import { getResumeData } from '@/lib/resume-loader';

const resume = getResumeData();
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const showcaseModules = buildShowcaseModules(resume, allProjects);
const caseStudies = allProjects.filter((p) => p.data.tier === 'case-study');
const additionalProjects = allProjects.filter((p) => p.data.tier === 'showcase-card');

const PROJECT_ANCHORS: Record<string, string> = {
  'enterprise-agentic-review': 'proj-flutter',
  'quadyx-autonomy': 'proj-quadyx',
  'electrocasnicu-rag': 'proj-electrocasnicu',
  'agri-rover': 'proj-agri-rover',
};

const PIXEL_PALETTE: Record<string, string> = {
  k: 'var(--ink-primary)',
  s: 'var(--ink-secondary)',
  m: 'var(--ink-muted)',
  w: 'var(--bg-elevated)',
  b: 'var(--accent-tech)',
  c: 'var(--accent-tech-3d)',
  o: 'var(--hw-actuator)',
  v: 'var(--accent-vermilion)',
};

const STACK_GLYPH_IDS = ['chip', 'gripper', 'terminal', 'uav'] as const;

function gridToRects(grid: readonly string[]) {
  const rects: Array<{ x: number; y: number; fill: string }> = [];
  grid.forEach((row, y) => {
    for (let x = 0; x < row.length; x++) {
      const ch = row[x];
      if (ch === '.') continue;
      rects.push({ x, y, fill: PIXEL_PALETTE[ch] || 'var(--ink-primary)' });
    }
  });
  return rects;
}

function glyphRects(glyphId: string) {
  const glyph = PIXEL_GLYPHS.find((g) => g.id === glyphId) ?? PIXEL_GLYPHS[0];
  return gridToRects(glyph.grid);
}

const graduationCapRects = gridToRects(GRADUATION_CAP_GRID);
---

<BaseLayout
  title={`${resume.profile.name} — ${resume.profile.headline}`}
  description={resume.profile.summary}
  canonicalPath="/"
  fullBleedHero
>
  <!-- 1. Full-Bleed 3D Kinematic Hero + Right-Edge Personal Badge -->
  <KinematicHero resume={resume} modules={showcaseModules} />
  <PersonalBadgeDialog />
  <ModulePreviewDialog modules={showcaseModules} />

  <!-- 2. Unified Editorial Grid with Sticky Desktop R1 CNC Vertical Rail Across All 5 Stations -->
  <div class="editorial-shell pt-12 lg:pt-16">
    <VerticalCncRail />

    <!-- #experience: Experience -->
    <section
      id="experience"
      aria-labelledby="experience-heading"
      class="clean-section editorial-row-exp mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:mx-0 lg:max-w-none lg:px-0"
    >
      <div class="clean-section-head">
        <h2 id="experience-heading" class="clean-section-title">Experience</h2>
      </div>

      <div class="mt-6 divide-y divide-hairline border-y border-hairline">
        {resume.experience.map((exp) => (
          <article class="clean-two-col py-7">
            <div class="clean-col-meta font-mono text-xs text-muted">
              <p class="font-medium text-ink tabular-nums">{exp.period}</p>
              <p class="mt-1">{exp.location}</p>
            </div>

            <div class="min-w-0">
              <h3 class="font-display text-lg font-bold tracking-[-0.02em] text-ink">
                {exp.url ? (
                  <a
                    href={exp.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    translate="no"
                    class="underline-offset-4 transition-colors hover:text-tech hover:underline"
                  >
                    {exp.company} <span aria-hidden="true">&#8599;</span>
                  </a>
                ) : (
                  <span translate="no">{exp.company}</span>
                )}
                <span class="mx-1.5 font-normal text-muted" aria-hidden="true">&middot;</span>
                <span class="font-semibold text-vermilion">{exp.role}</span>
              </h3>

              <ul class="clean-bullet-list mt-3.5 space-y-2 text-sm leading-relaxed text-ink-secondary">
                {exp.highlights.map((h) => (
                  <li>{h.text}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- #education: Education + Pixel-Art Graduation Cap Figurine -->
    <section
      id="education"
      aria-labelledby="education-heading"
      class="clean-section editorial-row-edu mx-auto w-full max-w-7xl border-t border-hairline px-4 py-14 sm:px-6 lg:mx-0 lg:max-w-none lg:px-0"
    >
      <div class="clean-section-head clean-section-head-edu">
        <div class="flex items-center gap-3.5">
          <h2 id="education-heading" class="clean-section-title">Education</h2>
          <span
            class="pv-shell pv-cap-frame"
            data-pixel-visual="graduation"
            data-in-view="false"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 23 15"
              width="46"
              height="30"
              shape-rendering="crispEdges"
              class="pixel-crisp"
            >
              {graduationCapRects.map((r) => (
                <rect x={r.x} y={r.y} width="1.03" height="1.03" fill={r.fill} />
              ))}
              <g class="pv-cap-tassel">
                {GRADUATION_TASSEL_RECTS.map((r) => (
                  <rect
                    x={r.x}
                    y={r.y}
                    width={r.w ?? 1.03}
                    height={r.h ?? 1.03}
                    fill={
                      r.fill === 'v'
                        ? 'var(--accent-vermilion)'
                        : r.fill === 'o'
                          ? 'var(--hw-actuator)'
                          : 'var(--ink-primary)'
                    }
                  />
                ))}
              </g>
            </svg>
          </span>
        </div>
      </div>

      <div class="mt-6 divide-y divide-hairline border-y border-hairline">
        {resume.education.map((edu) => (
          <article class="clean-two-col py-7">
            <div class="clean-col-meta font-mono text-xs text-muted">
              <p class="font-medium text-ink tabular-nums">{edu.period}</p>
              <p class="mt-1">{edu.institution}</p>
            </div>

            <div class="min-w-0">
              <h3 class="font-display text-base font-bold tracking-[-0.02em] text-ink">
                {edu.degree}
              </h3>

              {edu.thesis && (
                <p class="mt-2 text-sm leading-relaxed text-ink-secondary">
                  <span class="font-mono text-xs font-medium uppercase tracking-[0.06em] text-vermilion">
                    Thesis:
                  </span>{' '}
                  {edu.thesis.projectSlug === 'agri-rover' ? (
                    <a
                      href="#proj-agri-rover"
                      class="underline-offset-4 transition-colors hover:text-tech hover:underline"
                    >
                      {edu.thesis.title}
                    </a>
                  ) : (
                    edu.thesis.title
                  )}
                </p>
              )}

              {edu.courses.length > 0 && (
                <details class="clean-coursework mt-3">
                  <summary class="clean-coursework-summary font-mono text-xs font-medium text-tech">
                    <span>Coursework ({edu.courses.length})</span>
                  </summary>
                  <ul class="mt-2.5 space-y-2 border-l border-hairline pl-3.5 text-xs leading-relaxed text-ink-secondary">
                    {edu.courses.map((course) => (
                      <li>
                        <span class="font-semibold text-ink">{course.name}</span>
                        {' — '}
                        <span>{course.focus}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

      <!-- #projects: 3 Flagships (with Pixel Micro-Schematics) + 5 Compact Ledger Rows -->
      <section
        id="projects"
        aria-labelledby="projects-heading"
        class="clean-section editorial-row-proj mx-auto w-full max-w-7xl border-t border-hairline px-4 py-14 sm:px-6 lg:mx-0 lg:max-w-none lg:px-0"
      >
        <div class="clean-section-head">
          <h2 id="projects-heading" class="clean-section-title">Projects</h2>
        </div>

        <!-- 3 Flagship Systems -->
        <div class="mt-6 divide-y divide-hairline border-y border-hairline">
          {caseStudies.map((project) => {
            const slug = project.id.replace(/\.mdx$/, '');
            const anchorId = PROJECT_ANCHORS[slug] ?? `proj-${slug}`;
            const visualKind = project.data.visual ?? 'pipeline';

            return (
              <article id={anchorId} class="clean-flagship-band py-8">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="font-display text-xl font-bold tracking-[-0.025em] text-ink">
                      {project.data.title}
                    </h3>
                    <span class="font-mono text-xs font-medium text-vermilion tabular-nums">
                      {project.data.outcomeBadge}
                    </span>
                  </div>

                  <p class="mt-2.5 text-sm leading-relaxed text-ink-secondary">
                    {project.data.summary}
                  </p>

                  {project.data.highlights && project.data.highlights.length > 0 && (
                    <ul class="clean-bullet-list mt-3 space-y-1.5 text-[13.5px] leading-relaxed text-ink-secondary">
                      {project.data.highlights.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}

                  <div class="mt-4 flex flex-wrap items-center justify-between gap-x-5 gap-y-2">
                    <p class="font-mono text-xs text-muted">
                      {project.data.stack.join(' · ')}
                    </p>

                    <div class="flex shrink-0 items-center gap-4 font-mono text-xs">
                      {project.data.liveUrl && (
                        <a
                          href={project.data.liveUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex min-h-[32px] items-center gap-1 font-medium text-tech underline-offset-4 hover:underline"
                        >
                          <span>Live</span>
                          <span aria-hidden="true">&#8599;</span>
                        </a>
                      )}
                      {project.data.visibility === 'public' && project.data.repoUrl && (
                        <a
                          href={project.data.repoUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex min-h-[32px] items-center gap-1 font-medium text-ink underline-offset-4 hover:text-tech hover:underline"
                        >
                          <span>Repo</span>
                          <span aria-hidden="true">&#8599;</span>
                        </a>
                      )}
                    </div>
                  </div>

                  {project.data.visibility === 'anonymized' && project.data.anonymizationNote && (
                    <p class="mt-2 font-mono text-[11px] leading-relaxed text-muted">
                      {project.data.anonymizationNote}
                    </p>
                  )}
                </div>

                <div class="clean-visual-band shrink-0">
                  <ProjectPixelVisual visual={visualKind} />
                </div>
              </article>
            );
          })}
        </div>

        <!-- 5 Compact Ledger Rows (Agri-Rover first with inline mini rover) -->
        <div class="swiss-dim-list mt-6 divide-y divide-hairline border-b border-hairline">
          {additionalProjects.map((project) => {
            const slug = project.id.replace(/\.mdx$/, '');
            const anchorId = PROJECT_ANCHORS[slug] ?? `proj-${slug}`;
            const isRover = project.data.visual === 'rover';

            return (
              <article id={anchorId} class="swiss-dim-item clean-ledger-row py-4">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <h3 class="dim-title font-display text-base font-bold tracking-[-0.02em] text-ink">
                      {project.data.title}
                    </h3>
                    {isRover && <ProjectPixelVisual visual="rover" variant="compact" />}
                    <span class="font-mono text-xs font-medium text-vermilion tabular-nums">
                      {project.data.outcomeBadge}
                    </span>
                  </div>

                  <p class="mt-1 text-sm leading-relaxed text-ink-secondary">
                    {project.data.summary}
                  </p>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 font-mono text-xs lg:flex-col lg:items-end lg:justify-center">
                  <span class="text-muted">
                    {project.data.stack.slice(0, 4).join(' · ')}
                  </span>

                  <div class="flex shrink-0 items-center gap-3.5">
                    {project.data.liveUrl && (
                      <a
                        href={project.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-[32px] items-center gap-1 font-medium text-tech underline-offset-4 hover:underline"
                      >
                        <span>Live</span>
                        <span aria-hidden="true">&#8599;</span>
                      </a>
                    )}
                    {project.data.visibility === 'public' && project.data.repoUrl && (
                      <a
                        href={project.data.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-[32px] items-center gap-1 font-medium text-ink underline-offset-4 hover:text-tech hover:underline"
                      >
                        <span>Repo</span>
                        <span aria-hidden="true">&#8599;</span>
                      </a>
                    )}
                    {!project.data.liveUrl && !(project.data.visibility === 'public' && project.data.repoUrl) && (
                      <span class="text-[11px] uppercase tracking-[0.06em] text-muted">
                        {project.data.visibility === 'public' ? 'Hardware Prototype' : 'Private'}
                      </span>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

  <!-- 3. Certifications Band (Right-Bleed from Reading Column on Desktop, Full-Bleed on Mobile) -->
  <section
    id="certifications"
    aria-labelledby="certifications-heading"
    data-cert-mode="drones"
    class="clean-section editorial-row-certs border-t border-hairline py-14"
  >
    <div class="certs-header-wrap mx-auto w-full max-w-7xl px-4 sm:px-6">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-5">
        <h2 id="certifications-heading" class="clean-section-title">
          Certifications ({resume.certifications.length})
        </h2>

        <div class="cert-mode-switch" role="group" aria-label="Certifications display mode">
          <button
            id="cert-mode-drones"
            type="button"
            class="cert-mode-btn font-mono text-xs"
            aria-pressed="true"
            aria-controls="cert-drone-carousel"
            data-cert-toggle="drones"
          >
            Drones
          </button>
          <button
            id="cert-mode-list"
            type="button"
            class="cert-mode-btn font-mono text-xs"
            aria-pressed="false"
            aria-controls="certs-list-panel"
            data-cert-toggle="list"
          >
            List
          </button>
        </div>
      </div>
    </div>

    <CertificationCarousel certifications={resume.certifications} />

    <div id="certs-list-panel" hidden="until-found">
      <div class="certs-list-wrap mx-auto w-full max-w-7xl px-4 pt-2 sm:px-6">
        <CertificationGrid certifications={resume.certifications} />
      </div>
    </div>
  </section>

  <!-- 4. Technical Stack (4-Row Horizontal Matrix Aligned to Reading Column) -->
  <section
    id="stack"
    aria-labelledby="stack-heading"
    class="clean-section editorial-row-stack mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6 lg:mx-0 lg:max-w-none lg:px-0"
  >
    <div class="min-w-0 border-t border-hairline pt-12">
      <h2 id="stack-heading" class="clean-section-title">Technical Stack</h2>

      <div class="mt-6 divide-y divide-hairline border-y border-hairline">
        {resume.skillGroups.map((group, idx) => {
          const glyphId = STACK_GLYPH_IDS[idx % STACK_GLYPH_IDS.length];
          const rects = glyphRects(glyphId);

          return (
            <div class="clean-stack-row py-4">
              <div class="flex items-center gap-3">
                <svg
                  viewBox="0 0 9 9"
                  width="18"
                  height="18"
                  shape-rendering="crispEdges"
                  aria-hidden="true"
                  class="pixel-crisp shrink-0"
                >
                  {rects.map((r) => (
                    <rect x={r.x} y={r.y} width="1.03" height="1.03" fill={r.fill} />
                  ))}
                </svg>
                <h3 class="font-display text-sm font-semibold tracking-[-0.015em] text-ink">
                  {group.title}
                </h3>
              </div>

              <p class="font-mono text-xs leading-relaxed text-ink-secondary">
                {group.items.join(' · ')}
              </p>
            </div>
          );
        })}
      </div>
    </div>
  </section>
  </div>

  <!-- Certifications [Drones | List] Toggle + Ctrl+F beforematch + Safari Fallback -->
  <script>
    const certsSection = document.getElementById('certifications');
    const dronesBtn = document.getElementById('cert-mode-drones') as HTMLButtonElement | null;
    const listBtn = document.getElementById('cert-mode-list') as HTMLButtonElement | null;
    const carouselEl = document.getElementById('cert-drone-carousel');
    const listPanel = document.getElementById('certs-list-panel');

    if (certsSection && dronesBtn && listBtn && carouselEl && listPanel) {
      const supportsBeforeMatch = 'onbeforematch' in HTMLElement.prototype;

      const setCertMode = (mode: 'drones' | 'list') => {
        certsSection.setAttribute('data-cert-mode', mode);
        dronesBtn.setAttribute('aria-pressed', String(mode === 'drones'));
        listBtn.setAttribute('aria-pressed', String(mode === 'list'));

        if (mode === 'list') {
          carouselEl.hidden = true;
          carouselEl.setAttribute('data-paused', 'true');
          listPanel.removeAttribute('hidden');
        } else {
          carouselEl.hidden = false;
          carouselEl.setAttribute('data-paused', 'false');
          if (supportsBeforeMatch) {
            listPanel.setAttribute('hidden', 'until-found');
          } else {
            // Safari fallback: keep full list accessible below carousel for Cmd+F search
            listPanel.removeAttribute('hidden');
          }
        }
      };

      dronesBtn.addEventListener('click', () => setCertMode('drones'));
      listBtn.addEventListener('click', () => setCertMode('list'));

      listPanel.addEventListener('beforematch', () => {
        setCertMode('list');
      });

      if (!supportsBeforeMatch) {
        certsSection.setAttribute('data-beforematch-fallback', 'true');
        listPanel.removeAttribute('hidden');
      }
    }
  </script>

  <!-- Preserve Legacy v1.0 hash/query forwarding -->
  <script>
    import { resolveLegacyRedirect } from '@/lib/legacy-bridge';

    const redirectTarget = resolveLegacyRedirect(
      window.location.hash,
      window.location.search,
      import.meta.env.BASE_URL || '/',
    );
    if (redirectTarget) {
      window.addEventListener(
        'pageswap',
        (ev) => {
          const vt = (ev as { viewTransition?: { skipTransition?: () => void } }).viewTransition;
          vt?.skipTransition?.();
        },
        { once: true },
      );
      window.location.replace(redirectTarget);
    }
  </script>
</BaseLayout>
