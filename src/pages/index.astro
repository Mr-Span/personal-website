---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroMedia from '@/components/HeroMedia.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { SITE, withBase } from '@/data/site';
import { getResumeData } from '@/lib/resume-loader';

const resume = getResumeData();
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);

// Zero-post automatic gate: hide Latest Blog Post Bento tile while 0 published articles exist
const publishedPosts = (await getCollection('blog'))
  .filter((post) => post.data.published)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latestPost = publishedPosts[0] ?? null;
---

<BaseLayout
  title={`${SITE.name} — ${SITE.role}`}
  description={resume.profile.summary}
  canonicalPath="/"
>
  <!-- Hero Section (Clean, Zero Clutter, Single Visual Signature) -->
  <section aria-labelledby="hero-heading" class="grid grid-cols-1 items-start gap-8 pb-12 pt-4 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.9fr)] lg:gap-10">
    <div class="flex flex-col gap-5">
      <p class="font-mono text-xs font-medium uppercase tracking-widest text-baby">
        Applied AI &amp; Automation Systems · Cluj-Napoca
      </p>

      <h1 id="hero-heading" translate="no" class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        {SITE.name}
      </h1>

      <p class="font-display text-xl font-medium text-muted sm:text-2xl">
        {SITE.role} · Co-Founder at{' '}
        <a
          href={SITE.quadyxUrl}
          target="_blank"
          rel="noopener noreferrer"
          translate="no"
          class="text-ink underline decoration-baby/60 underline-offset-4 transition-colors hover:text-baby"
        >
          QUADYX
        </a>{' '}
        <span class="text-base font-normal text-muted">(Side Venture)</span>
      </p>

      <p class="max-w-2xl text-base leading-relaxed text-muted">
        {resume.profile.summary}
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href={withBase('/projects/')}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-coral px-5 text-sm font-semibold text-[var(--accent-on-contrast)] transition-opacity hover:opacity-90"
        >
          Explore Selected Work
          <span aria-hidden="true">&rarr;</span>
        </a>

        <a
          href={withBase('/resume/')}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-border-strong bg-surface px-5 text-sm font-semibold text-ink transition-colors hover:border-baby hover:text-baby"
        >
          Open Classic Resume
        </a>

        <a
          href={withBase('/Claudiu-Span-CV.pdf')}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-border-subtle bg-elevated px-4 text-sm font-semibold text-ink transition-colors hover:border-baby hover:text-baby"
        >
          Download ATS PDF
        </a>
      </div>
    </div>

    <HeroMedia />
  </section>

  <!-- Modular Bento Grid -->
  <section aria-labelledby="bento-overview-heading" class="space-y-8">
    <h2 id="bento-overview-heading" class="sr-only">Profile Overview and Selected Highlights</h2>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-12">
      <!-- About / Engineering Principles -->
      <article class="bento-card flex flex-col justify-between gap-4 p-6 md:col-span-7">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-baby">01 / Engineering Approach</p>
          <h3 class="mt-1.5 font-display text-2xl font-bold text-ink">
            Curious explorer with production engineering fundamentals
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            My primary work focuses on turning brittle operational processes into governed, production-grade Agentic AI and RPA pipelines — combining deterministic orchestration, strict enterprise PII boundaries, and human-in-the-loop review. Outside enterprise automation, I build autonomous UAV perception and telemetry stacks at QUADYX as a hands-on robotics side venture while finishing my MSc in Cyber-Physical Systems at UTCN.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4 border-t border-border-subtle pt-4 text-sm">
          <a href={withBase('/resume/#education')} class="font-medium text-baby underline-offset-4 hover:underline">
            UTCN MSc &amp; BSc Credentials &rarr;
          </a>
          <a href={withBase('/resume/#certifications')} class="font-medium text-ink underline-offset-4 hover:text-baby hover:underline">
            View All 6 Certifications &rarr;
          </a>
        </div>
      </article>

      <!-- Conditional Right Bento Tile: Latest Published Blog Post OR Verified Credentials Spotlight -->
      {latestPost ? (
        <article class="bento-card flex flex-col justify-between gap-4 p-6 md:col-span-5">
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-coral">Latest Engineering Note</p>
            <h3 class="mt-1.5 font-display text-xl font-bold text-ink">
              <a
                href={withBase(`/blog/${latestPost.id.replace(/\.mdx$/, '')}/`)}
                class="transition-colors hover:text-baby"
              >
                {latestPost.data.title}
              </a>
            </h3>
            <p class="mt-2 text-sm text-muted">{latestPost.data.summary}</p>
          </div>
          <div class="flex items-center justify-between border-t border-border-subtle pt-3 text-xs font-mono text-muted">
            <span>{latestPost.data.readingTime}</span>
            <a href={withBase('/blog/')} class="font-semibold text-baby hover:underline">
              All Notes &rarr;
            </a>
          </div>
        </article>
      ) : (
        <article class="bento-card flex flex-col justify-between gap-4 p-6 md:col-span-5">
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-signal">Verified Credentials</p>
            <h3 class="mt-1.5 font-display text-xl font-bold text-ink">
              6 Standalone Certifications &amp; MSc Track
            </h3>
            <ul class="mt-3 space-y-2 text-sm text-muted">
              {resume.certifications.slice(0, 4).map((cert) => (
                <li class="flex items-center justify-between gap-2">
                  <span class="text-ink">{cert.name}</span>
                  <span class="font-mono text-xs text-baby">{cert.credentialCode || cert.issuer}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="flex items-center justify-between border-t border-border-subtle pt-3 text-xs font-semibold">
            <a href={withBase('/resume/#certifications')} class="text-baby hover:underline">
              All 6 certifications on /resume &rarr;
            </a>
            <a href={withBase('/blog/')} class="text-muted hover:text-ink">
              Notes &amp; RSS
            </a>
          </div>
        </article>
      )}
    </div>

    <!-- Core Technical Stack -->
    <div class="bento-card p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-baby">02 / Technical Stack</p>
          <h3 class="mt-1 font-display text-xl font-bold text-ink">Production Tools &amp; Foundations</h3>
        </div>
        <a href={withBase('/resume/#skills')} class="text-sm font-medium text-baby hover:underline">
          Full Resume Breakdown &rarr;
        </a>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {resume.skillGroups.map((group) => (
          <div class="rounded-xl border border-border-subtle bg-elevated/60 p-4">
            <h4 class="font-display text-sm font-bold text-ink">{group.title}</h4>
            <ul class="mt-2.5 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="rounded border border-border-subtle bg-surface px-2 py-0.5 font-mono text-[11px] text-muted">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Flagship Selected Projects -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-wider text-baby">03 / Featured Case Studies</p>
          <h3 class="mt-1 font-display text-2xl font-bold text-ink">
            Interactive Architectures &amp; Production Systems
          </h3>
        </div>
        <a href={withBase('/projects/')} class="text-sm font-semibold text-baby underline-offset-4 hover:underline">
          View All {allProjects.length} Projects &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>

    <!-- Quick Contact -->
    <section id="contact" aria-labelledby="contact-heading" class="bento-card flex flex-col items-start justify-between gap-5 p-6 md:flex-row md:items-center">
      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-baby">04 / Direct Contact</p>
        <h3 id="contact-heading" class="mt-1 font-display text-2xl font-bold text-ink">
          Open to Applied AI &amp; Automation Engineering Roles
        </h3>
        <p class="mt-1.5 text-sm text-muted">
          Reach out directly for engineering interviews, production AI systems, or automation collaborations.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${SITE.email}`}
          class="inline-flex min-h-[44px] items-center rounded-lg bg-baby px-5 text-sm font-semibold text-[var(--accent-on-primary)] transition-opacity hover:opacity-90"
        >
          Send Email
        </a>
        <button
          id="copy-email-btn"
          type="button"
          data-email={SITE.email}
          class="inline-flex min-h-[44px] items-center rounded-lg border border-border-strong bg-elevated px-4 text-sm font-semibold text-ink transition-colors hover:border-baby hover:text-baby"
        >
          Copy Email
        </button>
        <a
          href={SITE.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center rounded-lg border border-border-subtle bg-surface px-4 text-sm font-semibold text-ink transition-colors hover:border-baby hover:text-baby"
        >
          LinkedIn &#8599;
        </a>
      </div>
    </section>
    <p id="copy-feedback" role="status" aria-live="polite" class="sr-only"></p>
  </section>

  <!-- Legacy v1.0 hash/query bridge + Copy email handler -->
  <script>
    import { resolveLegacyRedirect } from '@/lib/legacy-bridge';

    const redirectTarget = resolveLegacyRedirect(
      window.location.hash,
      window.location.search,
      import.meta.env.BASE_URL || '/',
    );
    if (redirectTarget) {
      window.location.replace(redirectTarget);
    }

    const copyBtn = document.getElementById('copy-email-btn');
    const feedback = document.getElementById('copy-feedback');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || '';
        try {
          await navigator.clipboard.writeText(email);
          copyBtn.textContent = 'Email Copied';
          if (feedback) feedback.textContent = `Copied ${email} to clipboard.`;
          setTimeout(() => {
            copyBtn.textContent = 'Copy Email';
          }, 1800);
        } catch {
          if (feedback) feedback.textContent = `Email address: ${email}`;
        }
      });
    }
  </script>
</BaseLayout>
