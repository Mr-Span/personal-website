---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CertificationGrid from '@/components/CertificationGrid.astro';
import { SITE, withBase } from '@/data/site';
import { getResumeData } from '@/lib/resume-loader';

const resume = getResumeData();
---

<BaseLayout
  title={`Resume & CV — ${SITE.name}`}
  description={`Structured engineering CV, verified credentials, and ATS PDF download for ${resume.profile.name} — ${resume.profile.headline}.`}
  canonicalPath="/resume/"
>
  <!-- Zone 1: Scannable Executive CV Header -->
  <header class="hw-panel mb-12 flex flex-col justify-between gap-6 p-6 sm:flex-row sm:items-end sm:p-8">
    <div>
      <p class="hw-eyebrow text-vermilion">
        <span class="px-beacon" aria-hidden="true"></span>
        <span>Curriculum Vitae</span>
      </p>
      <h1 class="mt-2.5 font-display text-3xl font-bold tracking-[-0.03em] text-ink sm:text-4xl" translate="no">
        {resume.profile.name}
      </h1>
      <p class="mt-1.5 text-base font-medium text-ink-secondary">
        {resume.profile.headline}
      </p>
      <p class="mt-1 font-mono text-xs text-muted">
        {resume.profile.location}
      </p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-secondary">{resume.profile.summary}</p>
    </div>

    <div class="no-print flex shrink-0 flex-col gap-2.5 sm:items-end">
      <a
        href={withBase('/Claudiu-Span-CV.pdf')}
        class="cta-anodized btn-press justify-center"
      >
        Download ATS PDF &darr;
      </a>
      <a
        href={`mailto:${resume.profile.email}`}
        class="font-mono text-xs font-semibold text-tech underline-offset-4 hover:underline"
      >
        {resume.profile.email}
      </a>
    </div>
  </header>

  <!-- Experience -->
  <section id="experience" aria-labelledby="exp-heading" class="mb-12">
    <div class="pb-3.5">
      <h2 id="exp-heading" class="font-display text-2xl font-bold tracking-[-0.03em] text-ink">
        Experience
      </h2>
    </div>

    <div class="hw-panel overflow-hidden divide-y divide-hairline">
      {resume.experience.map((exp) => (
        <article class="p-5 sm:p-6">
          <div class="flex flex-col justify-between gap-1.5 sm:flex-row sm:items-baseline">
            <div>
              <h3 class="font-display text-xl font-bold tracking-[-0.025em] text-ink">
                {exp.url ? (
                  <a
                    href={exp.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    translate="no"
                    class="underline-offset-4 transition-colors hover:text-tech hover:underline"
                  >
                    {exp.company} &#8599;
                  </a>
                ) : (
                  <span translate="no">{exp.company}</span>
                )}
              </h3>
              <p class="mt-0.5 text-sm font-semibold text-vermilion">{exp.role}</p>
            </div>
            <div class="font-mono text-xs text-muted sm:text-right">
              <p class="font-medium tabular-nums text-ink">{exp.period}</p>
              <p class="mt-0.5">{exp.location}</p>
            </div>
          </div>

          <ul class="mt-3.5 list-disc space-y-2 pl-5 text-sm leading-relaxed text-ink-secondary marker:text-vermilion">
            {exp.highlights.map((h) => (
              <li>{h.text}</li>
            ))}
          </ul>

          <p class="mt-4 border-t border-hairline pt-3 font-mono text-xs text-muted">
            Stack: {exp.stack.join(' · ')}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- All 6 Certifications Visible Simultaneously (2x3 Machined Hardware Grid, Ctrl+F searchable) -->
  <section id="certifications" aria-labelledby="certs-heading" class="mb-12 space-y-4">
    <div class="flex flex-wrap items-baseline justify-between gap-2 pb-1">
      <h2 id="certs-heading" class="font-display text-2xl font-bold tracking-[-0.03em] text-ink">
        Certifications ({resume.certifications.length})
      </h2>
      <span class="font-mono text-xs text-muted">All verified credentials visible upfront</span>
    </div>
    <CertificationGrid certifications={resume.certifications} />
  </section>

  <!-- Education with native <details> (Ctrl+F searchable) -->
  <section id="education" aria-labelledby="edu-heading" class="mb-12 space-y-4">
    <h2 id="edu-heading" class="pb-1 font-display text-2xl font-bold tracking-[-0.03em] text-ink">
      Education &amp; Academic Coursework
    </h2>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {resume.education.map((edu) => (
        <article class="hw-panel flex flex-col gap-3.5 p-5 sm:p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-lg font-bold tracking-[-0.02em] text-ink">{edu.degree}</h3>
            <span class="font-mono text-xs font-semibold text-vermilion tabular-nums">{edu.period}</span>
          </div>
          <p class="text-sm font-medium text-ink-secondary">{edu.institution}</p>

          {edu.thesis && (
            <div class="rounded-[10px] border border-hairline border-l-[3px] border-l-tech bg-recessed/80 p-3.5 text-xs">
              <p class="font-mono font-semibold uppercase tracking-[0.06em] text-muted">Thesis Focus</p>
              <p class="mt-1 font-semibold text-ink">{edu.thesis.title}</p>
              <p class="mt-1 leading-relaxed text-ink-secondary">{edu.thesis.summary}</p>
              {edu.thesis.projectSlug && (
                <a
                  href={withBase(`/projects/#${edu.thesis.projectSlug}`)}
                  class="mt-2 inline-block font-mono text-xs font-semibold text-tech underline-offset-4 hover:underline"
                >
                  View Hardware Showcase &rarr;
                </a>
              )}
            </div>
          )}

          <details class="rounded-[10px] border border-hairline bg-recessed/60 p-3.5 text-sm transition-colors open:border-strong">
            <summary class="font-semibold text-ink">
              Key Courses &amp; Projects ({edu.courses.length})
            </summary>
            <ul class="mt-3 space-y-2.5 text-xs text-ink-secondary">
              {edu.courses.map((course) => (
                <li class="border-t border-hairline pt-2.5">
                  <p class="font-semibold text-ink">{course.name}</p>
                  <p class="mt-0.5 leading-relaxed">{course.focus}</p>
                  {course.projectSummary && (
                    <p class="mt-1 font-mono text-tech">Project: {course.projectSummary}</p>
                  )}
                </li>
              ))}
            </ul>
          </details>
        </article>
      ))}
    </div>
  </section>

  <!-- Technical Stack Matrix (4 Typographic Hardware Columns — Zero Pill Soup) -->
  <section id="skills" aria-labelledby="skills-heading" class="space-y-4">
    <h2 id="skills-heading" class="pb-1 font-display text-2xl font-bold tracking-[-0.03em] text-ink">
      Technical Stack
    </h2>
    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
      {resume.skillGroups.map((group) => (
        <div class="hw-cell p-5">
          <h3 class="flex items-center gap-2 border-b border-hairline pb-2.5 font-display text-sm font-semibold tracking-[-0.02em] text-ink">
            <span class="px-beacon px-beacon-tech" aria-hidden="true"></span>
            <span>{group.title}</span>
          </h3>
          <ul class="mt-3 space-y-1.5 font-mono text-xs text-ink-secondary">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
