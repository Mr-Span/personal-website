---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      @page {
        size: A4;
        margin: 8.5mm 12mm;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: #0f172a;
        font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
        font-size: 8.8pt;
        line-height: 1.3;
      }

      h1 {
        margin: 0;
        font-size: 15.5pt;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #0f172a;
      }

      h2 {
        margin: 7.5pt 0 3pt 0;
        padding-bottom: 1.5pt;
        border-bottom: 1pt solid #cbd5e1;
        font-size: 9.4pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #0369a1;
        break-after: avoid;
      }

      h3 {
        margin: 0;
        font-size: 9.2pt;
        font-weight: 700;
        color: #0f172a;
      }

      p {
        margin: 0 0 3pt 0;
      }

      ul {
        margin: 2pt 0 3.5pt 0;
        padding-left: 13pt;
      }

      li {
        margin-bottom: 1.5pt;
      }

      a {
        color: #0369a1;
        text-decoration: none;
      }

      .header-meta {
        margin-top: 2pt;
        font-size: 8.4pt;
        color: #334155;
      }

      .entry {
        margin-bottom: 4.5pt;
      }

      .entry-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8pt;
      }

      .entry-sub {
        font-size: 8.3pt;
        color: #475569;
      }

      .stack-line {
        font-size: 8.2pt;
        color: #334155;
      }

      .cert-list {
        list-style: none;
        padding-left: 0;
        margin: 2pt 0 3pt 0;
      }

      .cert-list li {
        display: flex;
        justify-content: space-between;
        gap: 8pt;
        padding: 1pt 0;
        border-bottom: 0.5pt solid #e2e8f0;
      }

      .skill-row {
        margin-bottom: 2pt;
        font-size: 8.5pt;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
