---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      @page {
        size: A4;
        margin: 8mm 11.5mm;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        color: #151619;
        font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
        font-size: 8.6pt;
        line-height: 1.28;
      }

      h1 {
        margin: 0;
        font-size: 15pt;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: #151619;
      }

      h2 {
        margin: 7pt 0 3pt 0;
        padding-bottom: 1.5pt;
        border-bottom: 1pt solid #d4cfc4;
        font-size: 9pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #b33a10;
        break-after: avoid;
      }

      h3 {
        margin: 0;
        font-size: 9pt;
        font-weight: 700;
        color: #151619;
      }

      p {
        margin: 0 0 2.8pt 0;
      }

      ul {
        margin: 2pt 0 3.2pt 0;
        padding-left: 13pt;
      }

      li {
        margin-bottom: 1.4pt;
      }

      a {
        color: #0b5d8a;
        text-decoration: none;
      }

      .header-meta {
        margin-top: 2pt;
        font-size: 8.2pt;
        color: #4a4e57;
      }

      .entry {
        margin-bottom: 4pt;
      }

      .entry-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8pt;
      }

      .entry-sub {
        font-size: 8.1pt;
        color: #595d66;
      }

      .stack-line {
        font-size: 8pt;
        color: #4a4e57;
      }

      .cert-list {
        list-style: none;
        padding-left: 0;
        margin: 2pt 0 3pt 0;
      }

      .cert-list li {
        display: flex;
        justify-content: space-between;
        gap: 8pt;
        padding: 1pt 0;
        border-bottom: 0.5pt solid #d4cfc4;
      }

      .skill-row {
        margin-bottom: 1.8pt;
        font-size: 8.3pt;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
