---
import '@/styles/global.css';
import '@/styles/print.css';
import instrumentSansLatinUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import plexSansLatinUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import plexMono400Url from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE, absoluteUrl, withBase } from '@/data/site';
import { getResumeData } from '@/lib/resume-loader';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  fullBleedHero?: boolean;
}

const {
  title,
  description,
  canonicalPath = '/',
  ogType = 'website',
  fullBleedHero = false,
} = Astro.props;

const resume = getResumeData();
const canonicalUrl = absoluteUrl(canonicalPath);
const ogImageUrl = absoluteUrl('/og/default.png');
const isHome = canonicalPath === '/' || canonicalPath === '';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.profile.name,
  jobTitle: resume.profile.headline,
  url: absoluteUrl('/'),
  email: `mailto:${resume.profile.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cluj-Napoca',
    addressRegion: 'EU (Romania & Spain — Open to Relocation)',
    addressCountry: 'RO',
  },
  worksFor: [
    { '@type': 'Organization', name: 'Betfair Romania Development' },
    { '@type': 'Organization', name: 'QUADYX', url: SITE.quadyxUrl },
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Technical University of Cluj-Napoca',
  },
  sameAs: [SITE.githubUrl, SITE.linkedinUrl, SITE.quadyxUrl],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={resume.profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#EFECE7" />
    <meta name="build-sha" content={SITE.buildSha} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${resume.profile.name} — Engineering Notes`}
      href={withBase('/rss.xml')}
    />

    <!-- Preload critical self-hosted WOFF2 faces -->
    <link rel="preload" href={instrumentSansLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSansLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono400Url} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Block view-transition snapshot until header DOM & theme state settle -->
    <link rel="expect" href="#site-header" blocking="render" />

    <!-- Synchronous pre-paint OS-following + persisted override theme bootstrap (zero FOUC, WebView safe) -->
    <script is:inline {...({ blocking: 'render' } as Record<string, string>)}>
      (() => {
        const KEY = 'claudiu-span-theme-v2';
        let saved = null;
        try {
          const val = window.localStorage.getItem(KEY);
          if (val === 'light' || val === 'dark') saved = val;
        } catch {
          // Storage blocked in strict WebViews; keep OS polarity
        }
        const osDark =
          typeof window.matchMedia === 'function' &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        const effective = saved || (osDark ? 'dark' : 'light');

        document.documentElement.setAttribute('data-theme', effective);
        const cs = document.querySelector('meta[name="color-scheme"]');
        if (cs) cs.setAttribute('content', saved || 'light dark');
        const tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute('content', effective === 'dark' ? '#111317' : '#EFECE7');
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    {SITE.cfBeaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}
      ></script>
    )}
  </head>
  <body class="bg-canvas text-ink antialiased selection:bg-vermilion/20 selection:text-ink">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <Header currentPath={canonicalPath} />

    {fullBleedHero ? (
      <main id="main-content" class="relative z-[1] w-full">
        <slot />
      </main>
    ) : (
      <main id="main-content" class="relative z-[1] mx-auto w-full max-w-7xl px-4 pb-20 pt-8 sm:px-6 lg:px-8">
        <slot />
      </main>
    )}

    <Footer isHome={isHome} />

    <!-- Two-state OS-aware theme toggle & cross-tab synchronization -->
    <script is:inline>
      (() => {
        const KEY = 'claudiu-span-theme-v2';
        const mq =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null;

        function getOsPolarity() {
          return mq && mq.matches ? 'dark' : 'light';
        }

        function getSaved() {
          try {
            const v = window.localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch {
            return null;
          }
        }

        function applyTheme(override) {
          const effective = override || getOsPolarity();
          document.documentElement.setAttribute('data-theme', effective);
          const cs = document.querySelector('meta[name="color-scheme"]');
          if (cs) cs.setAttribute('content', override || 'light dark');
          const tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute('content', effective === 'dark' ? '#111317' : '#EFECE7');
        }

        const btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.addEventListener('click', () => {
            const current =
              document.documentElement.getAttribute('data-theme') || getOsPolarity();
            const target = current === 'dark' ? 'light' : 'dark';
            const osNow = getOsPolarity();
            if (target === osNow) {
              try {
                window.localStorage.removeItem(KEY);
              } catch {
                // Storage blocked; apply for session
              }
              applyTheme(null);
            } else {
              try {
                window.localStorage.setItem(KEY, target);
              } catch {
                // Storage blocked; apply for session
              }
              applyTheme(target);
            }
          });
        }

        if (mq) {
          mq.addEventListener('change', () => {
            if (!getSaved()) applyTheme(null);
          });
        }

        window.addEventListener('storage', (ev) => {
          if (ev.key === KEY) {
            const next =
              ev.newValue === 'light' || ev.newValue === 'dark' ? ev.newValue : null;
            applyTheme(next);
          }
        });
      })();
    </script>
  </body>
</html>
