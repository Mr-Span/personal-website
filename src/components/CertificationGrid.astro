---
import type { ResumeData } from '@/data/resume.schema';
import { resolveCertBrand } from '@/data/certification-logos';

interface Props {
  certifications: ResumeData['certifications'];
}

const { certifications } = Astro.props;
---

<!-- All verified certifications visible simultaneously in a scannable machined hardware grid (Ctrl+F & print friendly) -->
<div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
  {certifications.map((cert) => {
    const brand = resolveCertBrand(cert.issuer);
    return (
      <article class="hw-cell group flex flex-col justify-between gap-3.5 p-5 hover:-translate-y-0.5">
        <div>
          <div class="flex items-start justify-between gap-3">
            <div class="flex min-w-0 items-center gap-2.5">
              <span
                class="cert-brand-box"
                style={`width:${brand.boxWidth}px;height:${brand.boxHeight}px;`}
                set:html={brand.svg}
              />
              {brand.showIssuerLabel && (
                <span class="truncate font-mono text-[11px] font-medium uppercase tracking-[0.07em] text-vermilion">
                  {cert.issuer}
                </span>
              )}
            </div>
            <span class="shrink-0 font-mono text-[11px] text-muted tabular-nums">{cert.issuedDate}</span>
          </div>
          <h3 class="mt-3 font-display text-base font-semibold leading-snug tracking-[-0.02em] text-ink">
            {cert.name}
            {cert.credentialCode && (
              <span class="ml-1.5 inline-block rounded-[3px] border border-hairline bg-recessed px-1.5 py-0.5 align-middle font-mono text-[11px] font-medium text-tech">
                [{cert.credentialCode}]
              </span>
            )}
          </h3>
        </div>

        {cert.verifyUrl && (
          <div class="border-t border-hairline pt-2.5">
            <a
              href={cert.verifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[36px] items-center gap-1.5 font-mono text-xs font-semibold text-tech underline-offset-4 transition-colors hover:underline"
            >
              <span>Verify Credential</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&#8599;</span>
            </a>
          </div>
        )}
      </article>
    );
  })}
</div>
