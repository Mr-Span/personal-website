---
import type { ResumeData } from '@/data/resume.schema';
import { resolveCertBrand } from '@/data/certification-logos';

interface Props {
  certifications: ResumeData['certifications'];
}

const { certifications } = Astro.props;
---

<!-- Cleanroom hairline ledger of all verified certifications (Ctrl+F & print friendly, zero card boxes) -->
<div class="cert-clean-grid">
  {certifications.map((cert) => {
    const brand = resolveCertBrand(cert.issuer);
    const verifyHref =
      cert.verifyUrl ?? 'https://www.linkedin.com/in/claudiuspan/details/certifications/';
    return (
      <article class="cert-clean-row group">
        <div class="flex min-w-0 items-start gap-3.5">
          <span
            class="cert-brand-box"
            style={`width:${brand.boxWidth}px;height:${brand.boxHeight}px;`}
            set:html={brand.svg}
          />
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
              {brand.showIssuerLabel ? (
                <span class="font-mono text-[11px] font-medium uppercase tracking-[0.07em] text-vermilion">
                  {cert.issuer}
                </span>
              ) : (
                <span class="sr-only">{cert.issuer}</span>
              )}
              <span class="font-mono text-[11px] text-muted tabular-nums">
                {cert.credentialCode ? `${cert.credentialCode} · ` : ''}
                {cert.issuedDate}
              </span>
            </div>
            <h3 class="mt-0.5 font-display text-[15px] font-semibold leading-snug tracking-[-0.02em] text-ink">
              {cert.name}
            </h3>
          </div>
        </div>

        <div class="shrink-0 sm:pl-3">
          <a
            href={verifyHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[36px] items-center gap-1 font-mono text-xs font-medium text-tech underline-offset-4 transition-colors hover:underline"
            aria-label={`Verify ${cert.name}`}
          >
            <span>Verify</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&#8599;</span>
          </a>
        </div>
      </article>
    );
  })}
</div>
