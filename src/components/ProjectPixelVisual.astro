            {gridToRleRects(RETRIEVAL_CITE, 95, 22).map((r) => (
              <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
            ))}
          </g>
        </g>
      </svg>
    )}

    {visual === 'rover' && (
      <svg
        class="pv-svg pixel-crisp"
        viewBox="0 0 110 44"
        width="220"
        height="88"
        shape-rendering="crispEdges"
      >
        <g>
          {gridToRleRects(ROVER_ORCHARD_BG, 53, 25).map((r) => (
            <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
          ))}
          {gridToRleRects(ROVER_GROUND, 6, 34).map((r) => (
            <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
          ))}
        </g>

        <g class="pv-rover-full">
          <g class="pv-rover-gps">
            {gridToRleRects(ROVER_GPS, 14, 14).map((r) => (
              <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
            ))}
          </g>
          {gridToRleRects(ROVER_CRAFT, 10, 19).map((r) => (
            <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
          ))}
        </g>

        <g>
          {gridToRleRects(ROVER_FLAG_BASE, 86, 12).map((r) => (
            <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
          ))}
          <g class="pv-rover-flag-a">
            {gridToRleRects(ROVER_FLAG_A, 90, 12).map((r) => (
              <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
            ))}
          </g>
          <g class="pv-rover-flag-b">
            {gridToRleRects(ROVER_FLAG_B, 90, 12).map((r) => (
              <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />
            ))}
          </g>
        </g>
      </svg>
    )}
  </div>
)}

<script>
  const visuals = document.querySelectorAll<HTMLElement>('[data-pixel-visual]');

  if (visuals.length > 0) {
    if (typeof IntersectionObserver !== 'undefined') {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.target.setAttribute('data-in-view', String(entry.isIntersecting));
          }
        },
        { rootMargin: '80px 0px', threshold: 0.01 },
      );
      visuals.forEach((el) => io.observe(el));
    } else {
      visuals.forEach((el) => el.setAttribute('data-in-view', 'true'));
    }
  }
</script>
