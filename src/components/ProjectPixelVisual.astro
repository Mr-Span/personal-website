---

{variant === 'compact' && visual === 'rover' ? (
  <span
    class:list={['pv-shell pv-compact-track', className]}
    data-pixel-visual={visual}
    data-variant="compact"
    data-in-view="false"
    aria-hidden="true"
  >
    <svg
      class="pv-rover-compact pixel-crisp"
      viewBox="0 0 24 10"
      width="24"
      height="10"
      shape-rendering="crispEdges"
