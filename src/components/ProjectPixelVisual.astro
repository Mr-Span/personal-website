---
export type ProjectVisualKind = 'pipeline' | 'uav' | 'retrieval' | 'rover';

interface Props {
  visual: ProjectVisualKind;
  variant?: 'full' | 'compact';
  class?: string;
}

interface RleRect {
  x: number;
  y: number;
  w: number;
  h: string;
  fill: string;
}

const { visual, variant = 'full', class: className = '' } = Astro.props;

const PV_PALETTE: Record<string, string> = {
  k: 'var(--ink-primary)',
  s: 'var(--ink-secondary)',
  m: 'var(--ink-muted)',
  w: 'var(--bg-elevated)',
  b: 'var(--accent-tech)',
  c: 'var(--accent-tech-3d)',
  o: 'var(--hw-actuator)',
  v: 'var(--accent-vermilion)',
  g: 'var(--accent-signal)',
};

function gridToRleRects(grid: readonly string[], ox = 0, oy = 0): RleRect[] {
  const rects: RleRect[] = [];
  grid.forEach((row, dy) => {
    let x = 0;
    while (x < row.length) {
      const ch = row[x];
      if (ch === '.') {
        x++;
        continue;
      }
      let run = 1;
      while (x + run < row.length && row[x + run] === ch) {
        run++;
      }
      rects.push({
        x: ox + x,
        y: oy + dy,
        w: Number((run + 0.03).toFixed(2)),
        h: '1.03',
        fill: PV_PALETTE[ch] ?? 'var(--ink-primary)',
      });
      x += run;
    }
  });
  return rects;
}

