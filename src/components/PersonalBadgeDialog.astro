---
import { BADGE_SVG_PATHS, PERSONAL_BADGE } from '@/data/personal-badge';
---

<!-- Physically Lifted Floating Ceramic Badge Proxy Synced 1:1 to 3D Robot Lanyard-Hole Grip -->
<div id="badge-pull-proxy" class="badge-pull-proxy" aria-hidden="true">
  <svg class="badge-plate-svg" viewBox={BADGE_SVG_PATHS.viewBox} fill="none">
    <defs>
      <linearGradient id="badge-proxy-plate-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--badge-plate-top)" />
        <stop offset="56%" stop-color="var(--badge-plate-mid)" />
        <stop offset="100%" stop-color="var(--badge-plate-bot)" />
      </linearGradient>
    </defs>
    <path
      class="badge-proxy-outline"
      fill-rule="evenodd"
      fill="url(#badge-proxy-plate-grad)"
      stroke="var(--accent-vermilion)"
      stroke-width="1.6"
      d={BADGE_SVG_PATHS.monoblocEvenOdd}
    />
    <path class="badge-hole-rim is-clamped" d={BADGE_SVG_PATHS.holeContour} fill="none" stroke-width="1.8" />
    <path
      d={BADGE_SVG_PATHS.stitchContour}
      fill="none"
      stroke="var(--badge-stitch-channel)"
      stroke-width="5"
    />
    <path
      d={BADGE_SVG_PATHS.stitchContour}
      fill="none"
      stroke="var(--badge-stitch)"
      stroke-width="1.45"
      stroke-dasharray="5 3.5"
      stroke-linecap="round"
    />
  </svg>
  <span class="badge-dock-inner">
    <span class="badge-portrait-frame">
      <img
        src={PERSONAL_BADGE.portraitSrc}
        alt=""
        width="760"
        height="522"
        loading="lazy"
        decoding="async"
      />
      <svg class="badge-portrait-border" viewBox="0 0 219 141" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="31.5,1 187.5,1 218,24 218,140 1,140 1,24" fill="none" stroke="var(--border-strong)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
      </svg>
    </span>
    <span class="badge-preview-body">
      <span class="badge-bio-preview">{PERSONAL_BADGE.bioIntro} {PERSONAL_BADGE.bio}</span>
      <span class="badge-spoken-languages">{PERSONAL_BADGE.languagesLine}</span>
    </span>
    <span class="badge-dock-foot">
      <span class="badge-mini-icon-row">
        <span class="badge-mini-key">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        </span>
        <span class="badge-mini-key">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></svg>
        </span>
        <span class="badge-mini-key">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
        </span>
      </span>
    </span>
  </span>
</div>

<!-- Native Top-Layer Personal Corporate ID Badge Modal (<dialog closedby="any">) -->
<dialog
  id="personal-badge-dialog"
  closedby="any"
  class="dialog-badge"
  aria-label="Personal badge"
  data-email={PERSONAL_BADGE.email}
>
  <div id="personal-badge-card" class="badge-modal-card">
    <svg class="badge-plate-svg" viewBox={BADGE_SVG_PATHS.viewBox} fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="badge-modal-plate-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--badge-plate-top)" />
          <stop offset="56%" stop-color="var(--badge-plate-mid)" />
          <stop offset="100%" stop-color="var(--badge-plate-bot)" />
        </linearGradient>
      </defs>
      <path
        fill-rule="evenodd"
        fill="url(#badge-modal-plate-grad)"
        stroke="var(--badge-plate-stroke)"
        stroke-width="1.5"
        d={BADGE_SVG_PATHS.monoblocEvenOdd}
      />
      <path class="badge-hole-rim is-clamped" d={BADGE_SVG_PATHS.holeContour} fill="none" stroke-width="1.8" />
      <!-- C3 Embossed Channel + Warm Terracotta Retro Running Stitch -->
      <path
        d={BADGE_SVG_PATHS.stitchContour}
        fill="none"
        stroke="var(--badge-stitch-channel)"
        stroke-width="5"
      />
      <path
        d={BADGE_SVG_PATHS.stitchContour}
        fill="none"
        stroke="var(--badge-stitch)"
        stroke-width="1.45"
        stroke-dasharray="5 3.5"
        stroke-linecap="round"
      />
    </svg>

    <div class="badge-modal-inner">
      <!-- Subtle Frameless Close Button in top-right ceramic shoulder outside the portrait -->
      <form method="dialog" class="badge-close-form">
        <button
          id="personal-badge-close"
          type="submit"
          autofocus
          aria-label="Close personal badge"
          title="Close (Esc)"
          class="badge-close-btn"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
      </form>

      <div class="badge-portrait-frame">
        <img
          src={PERSONAL_BADGE.portraitSrc}
          alt={PERSONAL_BADGE.portraitAlt}
          width="760"
          height="522"
          loading="lazy"
          decoding="async"
        />
        <svg class="badge-portrait-border" viewBox="0 0 219 141" preserveAspectRatio="none" aria-hidden="true">
          <polygon points="31.5,1 187.5,1 218,24 218,140 1,140 1,24" fill="none" stroke="var(--border-strong)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <!-- Strictly Personal Natural Human Bio (Zero Capsules, Zero Bullets, Zero Lines) -->
      <div class="badge-modal-bio-block">
        <p class="badge-modal-bio">{PERSONAL_BADGE.bioIntro}</p>
        <p class="badge-modal-bio">{PERSONAL_BADGE.bio}</p>
        <p class="badge-modal-languages">{PERSONAL_BADGE.languagesLine}</p>
      </div>

      <!-- 3 Pictogram Action Buttons: Email (Copy), LinkedIn, GitHub -->
      <div class="badge-contact-footer">
        <div class="badge-icon-grid" role="group" aria-label="Direct contact channels">
          <button
            id="badge-btn-email"
            type="button"
            class="badge-icon-btn btn-press"
            aria-label="Copy email address"
            title={`Copy ${PERSONAL_BADGE.email}`}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.85"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            <span data-btn-label>Email</span>
          </button>

          <a
            href={PERSONAL_BADGE.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="badge-icon-btn btn-press"
            aria-label="Open LinkedIn profile"
            title="LinkedIn"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.85"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </svg>
            <span>LinkedIn</span>
          </a>

          <a
            href={PERSONAL_BADGE.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="badge-icon-btn btn-press"
            aria-label="Open GitHub profile"
            title="GitHub"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.85"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4" />
              <path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>

        <!-- Inline Live Email Readout (empty until clicked; reserved 1-line height) -->
        <p id="badge-contact-readout" role="status" aria-live="polite" class="badge-contact-readout"></p>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { attachLightDismissFallback } from '@/lib/dialog-utils';

  type BadgeCobotWindow = Window & {
    __cobotPickBadge?: (onReady: () => void) => void;
    __cobotReleaseBadge?: () => void;
  };

  const dialog = document.getElementById('personal-badge-dialog') as HTMLDialogElement | null;
  const triggerDesktop = document.getElementById('personal-badge-trigger') as HTMLButtonElement | null;
  const triggerMobile = document.getElementById('personal-badge-mobile-trigger') as HTMLButtonElement | null;
  const badgeCard = document.getElementById('personal-badge-card') as HTMLElement | null;
  const emailBtn = document.getElementById('badge-btn-email') as HTMLButtonElement | null;
  const readoutEl = document.getElementById('badge-contact-readout') as HTMLElement | null;

  if (dialog) {
    attachLightDismissFallback(dialog);

    const win = window as unknown as BadgeCobotWindow;
    const emailAddress = dialog.dataset.email || 'clauxspan2002@gmail.com';
    let emailLabelTimer: number | null = null;

    const resetContactReadout = () => {
      if (emailLabelTimer !== null) {
        window.clearTimeout(emailLabelTimer);
        emailLabelTimer = null;
      }
      const emailSpan = emailBtn?.querySelector('[data-btn-label]');
      if (emailSpan) emailSpan.textContent = 'Email';
      emailBtn?.classList.remove('is-confirmed');
    };

    const openBadgeImmediate = () => {
      if (!dialog.open) {
        dialog.showModal();
      }
    };

    const triggerBadgeInspect = (useRobotArm: boolean) => {
      if (dialog.open) return;
      if (useRobotArm && typeof win.__cobotPickBadge === 'function') {
        win.__cobotPickBadge(openBadgeImmediate);
      } else {
        openBadgeImmediate();
      }
    };

    triggerDesktop?.addEventListener('click', () => triggerBadgeInspect(true));
    triggerMobile?.addEventListener('click', () => triggerBadgeInspect(false));

    // Blur restored focus on desktop trigger after Esc so hover/focus lean-in never sticks
    const blurRestoredTrigger = () => {
      const activeEl = document.activeElement as HTMLElement | null;
      if (activeEl && activeEl.id === 'personal-badge-trigger') {
        activeEl.blur();
      }
    };

    dialog.addEventListener('close', () => {
      dialog.returnValue = '';
      if (badgeCard) {
        badgeCard.style.setProperty('--badge-tilt-x', '0deg');
        badgeCard.style.setProperty('--badge-tilt-y', '0deg');
      }
      resetContactReadout();
      if (readoutEl) {
        readoutEl.textContent = '';
      }
      win.__cobotReleaseBadge?.();
      blurRestoredTrigger();
      queueMicrotask(blurRestoredTrigger);
    });

    // Email pictogram button -> Copy email & display cleanly underneath
    emailBtn?.addEventListener('click', async () => {
      const label = emailBtn.querySelector('[data-btn-label]');
      if (emailLabelTimer !== null) window.clearTimeout(emailLabelTimer);
      try {
        await navigator.clipboard.writeText(emailAddress);
        if (label) label.textContent = 'Copied';
        emailBtn.classList.add('is-confirmed');
      } catch {
        // Clipboard blocked; still display address underneath
      }
      if (readoutEl) readoutEl.textContent = emailAddress;
      emailLabelTimer = window.setTimeout(() => {
        if (label) label.textContent = 'Email';
        emailBtn.classList.remove('is-confirmed');
        emailLabelTimer = null;
      }, 1800);
    });

    // Tactile subtle 3D tilt when holding pointer over the open ceramic badge (fine-pointer + motion OK)
    if (
      badgeCard &&
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      badgeCard.addEventListener('pointermove', (e) => {
        const rect = badgeCard.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;
        const nx = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
        const ny = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
        badgeCard.style.setProperty('--badge-tilt-y', `${(nx * 5).toFixed(2)}deg`);
        badgeCard.style.setProperty('--badge-tilt-x', `${(-ny * 4).toFixed(2)}deg`);
      });
      badgeCard.addEventListener('pointerleave', () => {
        badgeCard.style.setProperty('--badge-tilt-x', '0deg');
        badgeCard.style.setProperty('--badge-tilt-y', '0deg');
      });
    }
  }
</script>
