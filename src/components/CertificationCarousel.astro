---
import type { ResumeData } from '@/data/resume.schema';
import { resolveCertBrand } from '@/data/certification-logos';
import { CARGO_DRONE_GRID } from '@/data/showcase-modules';

interface Props {
  certifications: ResumeData['certifications'];
}

const { certifications } = Astro.props;

const PIXEL_PALETTE: Record<string, string> = {
  k: 'var(--ink-primary)',
  s: 'var(--ink-secondary)',
  m: 'var(--ink-muted)',
  w: 'var(--bg-elevated)',
  b: 'var(--accent-tech)',
  c: 'var(--accent-tech-3d)',
  o: 'var(--hw-actuator)',
};

const droneRects: Array<{ x: number; y: number; fill: string }> = [];
CARGO_DRONE_GRID.forEach((row, y) => {
  for (let x = 0; x < row.length; x++) {
    const ch = row[x];
    if (ch === '.') continue;
    droneRects.push({ x, y, fill: PIXEL_PALETTE[ch] || 'var(--ink-primary)' });
  }
});

// Organic non-linear flight profiles (staggered altitude, prime bob periods, subtle natural swing)
const FLIGHT_PROFILES = [
  { y: -9, amp: 6, dur: 3.7, delay: -0.4, sway: 1.4, sdur: 4.9, pitch: -8 },
  { y: 8, amp: 7, dur: 4.3, delay: -1.9, sway: 1.6, sdur: 5.5, pitch: -6 },
  { y: -4, amp: 5, dur: 5.1, delay: -2.8, sway: 1.2, sdur: 4.4, pitch: -9 },
  { y: 10, amp: 6, dur: 3.9, delay: -0.9, sway: 1.5, sdur: 5.2, pitch: -7 },
  { y: -10, amp: 7, dur: 4.7, delay: -3.1, sway: 1.7, sdur: 4.7, pitch: -8 },
  { y: 5, amp: 6, dur: 5.3, delay: -1.3, sway: 1.3, sdur: 5.7, pitch: -6 },
  { y: -6, amp: 7, dur: 4.1, delay: -2.4, sway: 1.5, sdur: 4.5, pitch: -9 },
  { y: 9, amp: 5, dur: 4.9, delay: -0.2, sway: 1.4, sdur: 5.3, pitch: -7 },
  { y: -8, amp: 6, dur: 3.6, delay: -2.1, sway: 1.5, sdur: 4.8, pitch: -8 },
  { y: 6, amp: 7, dur: 4.5, delay: -1.5, sway: 1.3, sdur: 5.1, pitch: -6 },
] as const;

const enriched = certifications.map((cert, idx) => ({
  cert,
  brand: resolveCertBrand(cert.issuer),
  flight: FLIGHT_PROFILES[idx % FLIGHT_PROFILES.length],
}));
---

<!-- D1 Overhead 2D Pixel Cargo Drone Organic Certification Carousel (Right -> Left, pauses on hover/focus) -->
<div
  id="cert-drone-carousel"
  class="cert-carousel-shell"
  data-in-view="false"
  role="region"
  aria-roledescription="carousel"
  aria-label="Verified technical certifications carried by retro pixel cargo drones"
>
  <div class="cert-marquee-window">
    <div class="cert-marquee-track">
      <!-- Primary interactive credential track -->
      <div class="cert-marquee-group">
        {enriched.map(({ cert, brand, flight }) => (
          <div
            class="cert-flight-unit"
            style={`--base-y:${flight.y}px;--bob-amp:${flight.amp}px;--bob-dur:${flight.dur}s;--bob-delay:${flight.delay}s;--sway-deg:${flight.sway}deg;--sway-dur:${flight.sdur}s;--drone-pitch:${flight.pitch}deg;`}
          >
            <div class="cert-flight-bob">
              <div class="cert-drone-wrap" aria-hidden="true">
                <svg
                  class="cert-drone-svg pixel-crisp"
                  viewBox="0 0 23 12"
                  width="46"
                  height="24"
                  shape-rendering="crispEdges"
                >
                  {droneRects.map((r) => (
                    <rect x={r.x} y={r.y} width="1.04" height="1.04" fill={r.fill} />
                  ))}
                  <!-- Left rotor spinning horizontal blades (Frame A wide <-> Frame B foreshortened) -->
                  <g class="cert-prop-wide">
                    <rect x="0" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                    <rect x="1" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="4" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="6" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                  </g>
                  <g class="cert-prop-narrow">
                    <rect x="0" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                    <rect x="2" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="4" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="5" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                  </g>
                  <!-- Right rotor spinning horizontal blades (counter-phased so both propellers visibly spin) -->
                  <g class="cert-prop-narrow">
                    <rect x="16" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                    <rect x="17" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="20" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="22" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                  </g>
                  <g class="cert-prop-wide">
                    <rect x="16" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                    <rect x="18" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="20" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="21" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                  </g>
                </svg>
              </div>

              <!-- Twin suspension chains anchored directly to the drone's center belly fuselage (clear of propellers) -->
              <svg class="cert-cables-svg" viewBox="0 0 112 20" fill="none" aria-hidden="true">
                <circle cx="56" cy="2" r="2" fill="var(--ink-secondary)" />
                <line
                  x1="54.8"
                  y1="2.5"
                  x2="20"
                  y2="20"
                  stroke="var(--cert-cable)"
                  stroke-width="1.35"
                  stroke-dasharray="2.6 1.8"
                />
                <line
                  x1="57.2"
                  y1="2.5"
                  x2="92"
                  y2="20"
                  stroke="var(--cert-cable)"
                  stroke-width="1.35"
                  stroke-dasharray="2.6 1.8"
                />
                <circle cx="20" cy="19" r="1.6" fill="var(--accent-vermilion)" />
                <circle cx="92" cy="19" r="1.6" fill="var(--accent-vermilion)" />
              </svg>

              <div class="cert-payload-sway">
                <a
                  href={cert.verifyUrl ?? 'https://www.linkedin.com/in/claudiuspan/details/certifications/'}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cert-banner-card group"
                >
                  <span
                    class="cert-brand-box"
                    style={`width:${brand.boxWidth}px;height:${brand.boxHeight}px;`}
                    set:html={brand.svg}
                  />
                  <span class="min-w-0 flex-1">
                    {brand.showIssuerLabel ? (
                      <span class="cert-banner-issuer block truncate">{cert.issuer}</span>
                    ) : (
                      <span class="sr-only">{cert.issuer} — </span>
                    )}
                    <span class="cert-banner-name block">{cert.name}</span>
                    <span class="cert-banner-meta mt-0.5 flex items-center justify-between gap-2">
                      <span>
                        {cert.credentialCode ? `${cert.credentialCode} · ` : ''}
                        {cert.issuedDate}
                      </span>
                      <span
                        aria-hidden="true"
                        class="text-tech transition-transform group-hover:translate-x-0.5"
                      >
                        &#8599;
                      </span>
                    </span>
                    <span class="sr-only"> (verify credential)</span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Seamless loop clone (hidden from screen readers & keyboard focus) -->
      <div class="cert-marquee-group cert-marquee-clone" aria-hidden="true">
        {enriched.map(({ cert, brand, flight }) => (
          <div
            class="cert-flight-unit"
            style={`--base-y:${flight.y}px;--bob-amp:${flight.amp}px;--bob-dur:${flight.dur}s;--bob-delay:${flight.delay}s;--sway-deg:${flight.sway}deg;--sway-dur:${flight.sdur}s;--drone-pitch:${flight.pitch}deg;`}
          >
            <div class="cert-flight-bob">
              <div class="cert-drone-wrap">
                <svg
                  class="cert-drone-svg pixel-crisp"
                  viewBox="0 0 23 12"
                  width="46"
                  height="24"
                  shape-rendering="crispEdges"
                >
                  {droneRects.map((r) => (
                    <rect x={r.x} y={r.y} width="1.04" height="1.04" fill={r.fill} />
                  ))}
                  <!-- Left rotor spinning horizontal blades (Frame A wide <-> Frame B foreshortened) -->
                  <g class="cert-prop-wide">
                    <rect x="0" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                    <rect x="1" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="4" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="6" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                  </g>
                  <g class="cert-prop-narrow">
                    <rect x="0" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                    <rect x="2" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="4" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="5" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                  </g>
                  <!-- Right rotor spinning horizontal blades (counter-phased so both propellers visibly spin) -->
                  <g class="cert-prop-narrow">
                    <rect x="16" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                    <rect x="17" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="20" y="1" width="2.04" height="1.04" fill="var(--ink-primary)" />
                    <rect x="22" y="1" width="1.04" height="1.04" fill="var(--ink-muted)" />
                  </g>
                  <g class="cert-prop-wide">
                    <rect x="16" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                    <rect x="18" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="20" y="1" width="1.04" height="1.04" fill="var(--ink-secondary)" />
                    <rect x="21" y="1" width="2.04" height="1.04" fill="var(--accent-tech-3d)" opacity="0.42" />
                  </g>
                </svg>
              </div>

              <svg class="cert-cables-svg" viewBox="0 0 112 20" fill="none">
                <circle cx="56" cy="2" r="2" fill="var(--ink-secondary)" />
                <line
                  x1="54.8"
                  y1="2.5"
                  x2="20"
                  y2="20"
                  stroke="var(--cert-cable)"
                  stroke-width="1.35"
                  stroke-dasharray="2.6 1.8"
                />
                <line
                  x1="57.2"
                  y1="2.5"
                  x2="92"
                  y2="20"
                  stroke="var(--cert-cable)"
                  stroke-width="1.35"
                  stroke-dasharray="2.6 1.8"
                />
                <circle cx="20" cy="19" r="1.6" fill="var(--accent-vermilion)" />
                <circle cx="92" cy="19" r="1.6" fill="var(--accent-vermilion)" />
              </svg>

              <div class="cert-payload-sway">
                <a
                  href={cert.verifyUrl ?? 'https://www.linkedin.com/in/claudiuspan/details/certifications/'}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex="-1"
                  class="cert-banner-card group"
                >
                  <span
                    class="cert-brand-box"
                    style={`width:${brand.boxWidth}px;height:${brand.boxHeight}px;`}
                    set:html={brand.svg}
                  />
                  <span class="min-w-0 flex-1">
                    {brand.showIssuerLabel && (
                      <span class="cert-banner-issuer block truncate">{cert.issuer}</span>
                    )}
                    <span class="cert-banner-name block">{cert.name}</span>
                    <span class="cert-banner-meta mt-0.5 flex items-center justify-between gap-2">
                      <span>
                        {cert.credentialCode ? `${cert.credentialCode} · ` : ''}
                        {cert.issuedDate}
                      </span>
                      <span class="text-tech">&#8599;</span>
                    </span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const carousel = document.getElementById('cert-drone-carousel');

  if (carousel) {
    // Pause all off-screen drone & propeller compositor animations until carousel approaches viewport
    if (typeof IntersectionObserver !== 'undefined') {
      const io = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (entry) {
            carousel.setAttribute('data-in-view', String(entry.isIntersecting));
          }
        },
        { rootMargin: '120px 0px', threshold: 0.01 },
      );
      io.observe(carousel);
    } else {
      carousel.setAttribute('data-in-view', 'true');
    }
  }
</script>
