---
import { SITE, withBase } from '@/data/site';

interface CommandItem {
  id: string;
  group: string;
  label: string;
  sub: string;
  kbd: string;
  actionType: 'route' | 'module' | 'theme' | 'copy-email' | 'motion';
  target?: string;
  moduleIndex?: number;
  requiresKinematic?: boolean;
}

const commands: CommandItem[] = [
  { id: 'mod-0', group: 'Pick Cartridge with 3D Cobot', label: 'Profile & CV', sub: 'Overview, Betfair Mar 2022–Jan 2027 & UTCN MSc', kbd: 'PICK', actionType: 'module', target: withBase('/resume/'), moduleIndex: 0 },
  { id: 'mod-1', group: 'Pick Cartridge with 3D Cobot', label: 'Flutter UK&I — RPA Automation', sub: '40+ workflows, Maestro LLM review (-70%), Python, APIs & SQL', kbd: 'PICK', actionType: 'module', target: withBase('/projects/enterprise-agentic-review/'), moduleIndex: 1 },
  { id: 'mod-2', group: 'Pick Cartridge with 3D Cobot', label: 'QUADYX', sub: 'ROS 2 · Algorithms (ORB-SLAM3 + Depth V2), Calibration & Precision Landing', kbd: 'PICK', actionType: 'module', target: withBase('/projects/quadyx-autonomy/'), moduleIndex: 2 },
  { id: 'mod-3', group: 'Pick Cartridge with 3D Cobot', label: 'ElectrocasNicu — Agentic AI', sub: 'Agentic AI RAG chat for appliance manuals with cited pages', kbd: 'PICK', actionType: 'module', target: withBase('/projects/electrocasnicu-rag/'), moduleIndex: 3 },
  { id: 'mod-4', group: 'Pick Cartridge with 3D Cobot', label: 'Agri-Rover', sub: 'UTCN BSc · Autonomous C++ Orchard Rover', kbd: 'PICK', actionType: 'module', target: withBase('/projects/#agri-rover'), moduleIndex: 4 },
  { id: 'mod-5', group: 'Pick Cartridge with 3D Cobot', label: 'Credentials & Contact', sub: '10 Verified Certifications & EU Direct Channels', kbd: 'PICK', actionType: 'module', target: withBase('/resume/#certifications'), moduleIndex: 5 },
  { id: 'nav-projects', group: 'Navigation & ATS', label: 'All Projects & Architectures', sub: 'Interactive diagrams, case studies & showcase', kbd: 'GO', actionType: 'route', target: withBase('/projects/') },
  { id: 'nav-resume', group: 'Navigation & ATS', label: 'Structured Resume & 10 Certifications', sub: 'Experience, UTCN education & verified credentials', kbd: 'GO', actionType: 'route', target: withBase('/resume/') },
  { id: 'nav-pdf', group: 'Navigation & ATS', label: 'Download ATS PDF Resume', sub: '1-Page A4 machine-extractable PDF', kbd: 'PDF', actionType: 'route', target: withBase('/Claudiu-Span-CV.pdf') },
  { id: 'nav-blog', group: 'Navigation & ATS', label: 'Engineering Notes & RSS', sub: 'Technical write-ups & subscription feed', kbd: 'GO', actionType: 'route', target: withBase('/blog/') },
  { id: 'nav-llms', group: 'Navigation & ATS', label: 'Open /llms.txt (AI-Native Index)', sub: 'Structured summary for MCP & LLM agents', kbd: 'TXT', actionType: 'route', target: withBase('/llms.txt') },
  { id: 'act-theme', group: 'Workspace Controls', label: 'Switch Warm Ceramic Light / Charcoal Dark', sub: 'CSS tokens + 3D hardware PBR studio lighting', kbd: 'THEME', actionType: 'theme' },
  { id: 'act-copy', group: 'Workspace Controls', label: `Copy Email (${SITE.email})`, sub: 'Clipboard copy', kbd: 'COPY', actionType: 'copy-email', target: SITE.email },
];
---

<dialog
  id="cmd-palette"
  closedby="any"
  class="dialog-cmd"
  aria-label="Command palette"
  data-commands={JSON.stringify(commands)}
>
  <div class="flex items-center gap-3 border-b border-hairline px-4 py-3.5">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-muted" aria-hidden="true">
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <input
      id="cmd-search"
      type="search"
      autocomplete="off"
      placeholder="Pick a 3D cartridge, jump to route, ATS PDF, theme, or motion..."
      class="w-full bg-transparent text-sm text-ink placeholder:text-muted focus:outline-none"
      aria-label="Filter commands"
    />
    <form method="dialog" class="shrink-0">
      <button
        type="submit"
        class="rounded-md border border-strong bg-surface px-2 py-1 font-mono text-[11px] font-medium text-muted shadow-[var(--shadow-bevel)] hover:border-ink hover:text-ink"
      >
        ESC
      </button>
    </form>
  </div>

  <div id="cmd-results" class="max-h-[360px] overflow-y-auto p-2" role="listbox" aria-label="Available commands"></div>
  <p id="cmd-live-status" class="sr-only" role="status" aria-live="polite"></p>
</dialog>

<script>
  import { attachLightDismissFallback } from '@/lib/dialog-utils';

  interface CommandItem {
    id: string;
    group: string;
    label: string;
    sub: string;
    kbd: string;
    actionType: 'route' | 'module' | 'theme' | 'copy-email' | 'motion';
    target?: string;
    moduleIndex?: number;
    requiresKinematic?: boolean;
  }

  const dialog = document.getElementById('cmd-palette') as HTMLDialogElement | null;
  const input = document.getElementById('cmd-search') as HTMLInputElement | null;
  const listEl = document.getElementById('cmd-results');
  const statusEl = document.getElementById('cmd-live-status');
  const openBtn = document.getElementById('cmd-open-btn');

  if (dialog && input && listEl) {
    attachLightDismissFallback(dialog);

    const allCommands: CommandItem[] = JSON.parse(dialog.dataset.commands || '[]');
    let filtered: CommandItem[] = [];
    let selectedIndex = 0;

    function isKinematicAvailable(): boolean {
      const stage = document.querySelector('[data-kinematic-stage]');
      return Boolean(stage && window.matchMedia('(min-width: 1024px) and (pointer: fine)').matches);
    }

    function executeCommand(item: CommandItem) {
      dialog!.close();
      if (item.actionType === 'module') {
        const visorTrigger = document.querySelector(
          `[data-station-index="${item.moduleIndex}"]`,
        ) as HTMLElement | null;
        const opener = (window as unknown as { __openModuleVisor?: (i: number) => void }).__openModuleVisor;
        if (visorTrigger && typeof opener === 'function') {
          opener(item.moduleIndex ?? 0);
          return;
        }
        if (item.target) window.location.href = item.target;
      } else if (item.actionType === 'route' && item.target) {
        window.location.href = item.target;
      } else if (item.actionType === 'theme') {
        document.getElementById('theme-toggle')?.click();
      } else if (item.actionType === 'copy-email' && item.target) {
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(item.target).catch(() => {});
        }
        if (statusEl) statusEl.textContent = `Copied ${item.target} to clipboard.`;
      } else if (item.actionType === 'motion') {
        document.getElementById('btn-motion-toggle')?.click();
      }
    }

    function renderList() {
      const q = input!.value.trim().toLowerCase();
      const hasKinematic = isKinematicAvailable();
      filtered = allCommands.filter((item) => {
        if (item.requiresKinematic && !hasKinematic) return false;
        if (!q) return true;
        return item.label.toLowerCase().includes(q) || item.sub.toLowerCase().includes(q);
      });

      selectedIndex = Math.min(selectedIndex, Math.max(0, filtered.length - 1));
      listEl!.textContent = '';

      if (filtered.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'px-3 py-6 text-center font-mono text-xs text-muted';
        empty.textContent = 'No matching commands.';
        listEl!.appendChild(empty);
        return;
      }

      let currentGroup = '';
      filtered.forEach((item, idx) => {
        if (item.group !== currentGroup) {
          currentGroup = item.group;
          const heading = document.createElement('div');
          heading.className = 'px-2.5 pb-1 pt-2.5 font-mono text-[10.5px] font-semibold uppercase tracking-[0.1em] text-muted';
          heading.textContent = currentGroup;
          listEl!.appendChild(heading);
        }

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'option');
        btn.setAttribute('aria-selected', idx === selectedIndex ? 'true' : 'false');
        btn.className = [
          'flex w-full items-center justify-between gap-3 rounded-[9px] px-3 py-2 text-left transition-colors',
          idx === selectedIndex ? 'bg-[var(--vermilion-tint)] text-ink' : 'text-ink-secondary hover:bg-surface',
        ].join(' ');

        const left = document.createElement('span');
        left.className = 'min-w-0';
        const title = document.createElement('span');
        title.className = 'block truncate text-sm font-medium text-ink';
        title.textContent = item.label;
        const sub = document.createElement('span');
        sub.className = 'block truncate text-xs text-muted';
        sub.textContent = item.sub;
        left.append(title, sub);

        const kbd = document.createElement('span');
        kbd.className = 'shrink-0 rounded-[5px] border border-hairline bg-surface px-1.5 py-0.5 font-mono text-[10px] font-semibold text-muted';
        kbd.textContent = item.kbd;

        btn.append(left, kbd);
        btn.addEventListener('mouseenter', () => {
          selectedIndex = idx;
          renderList();
        });
        btn.addEventListener('click', () => executeCommand(item));
        listEl!.appendChild(btn);
      });
    }

    function openPalette() {
      const openVisor = document.getElementById('module-visor') as HTMLDialogElement | null;
      if (openVisor?.open) openVisor.close();
      if (!dialog!.open) {
        input!.value = '';
        selectedIndex = 0;
        renderList();
        dialog!.showModal();
        input!.focus();
      }
    }

    openBtn?.addEventListener('click', openPalette);
    input.addEventListener('input', () => {
      selectedIndex = 0;
      renderList();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % Math.max(1, filtered.length);
        renderList();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + Math.max(1, filtered.length)) % Math.max(1, filtered.length);
        renderList();
      } else if (e.key === 'Enter' && filtered[selectedIndex]) {
        e.preventDefault();
        executeCommand(filtered[selectedIndex]);
      }
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else openPalette();
      }
    });
  }
</script>
