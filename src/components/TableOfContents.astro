---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const visibleHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{visibleHeadings.length > 0 && (
  <aside class="hidden lg:block" aria-label="Table of contents">
    <nav class="sticky top-24 rounded-xl border border-border-subtle bg-surface p-4">
      <p class="font-mono text-xs uppercase tracking-wider text-baby">On This Page</p>
      <ul class="mt-3 space-y-2 text-sm">
        {visibleHeadings.map((h) => (
          <li class={h.depth === 3 ? 'pl-3' : ''}>
            <a
              href={`#${h.slug}`}
              class="block text-muted transition-colors hover:text-baby"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}
