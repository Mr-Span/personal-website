---
import { SITE, withBase } from '@/data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { label: 'Home', href: withBase('/'), match: '/' },
  { label: 'Projects', href: withBase('/projects/'), match: '/projects' },
  { label: 'Resume', href: withBase('/resume/'), match: '/resume' },
  { label: 'Blog', href: withBase('/blog/'), match: '/blog' },
];

function isActive(match: string): boolean {
  if (match === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(match);
}
---

<header class="sticky top-0 z-[var(--z-sticky)] border-b border-border-subtle bg-canvas/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a
      href={withBase('/')}
      class="flex shrink-0 items-center gap-2 text-sm font-semibold tracking-tight text-ink no-underline"
    >
      <span
        aria-hidden="true"
        class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border-subtle bg-surface font-mono text-xs font-semibold text-baby"
      >
        {SITE.shortName}
      </span>
      <span translate="no" class="hidden font-display text-base font-bold sm:inline">{SITE.name}</span>
      <span class="sr-only">Home</span>
    </a>

    <nav aria-label="Primary navigation" class="flex min-w-0 items-center gap-0.5 sm:gap-2">
      {navItems.map((item) => {
        const active = isActive(item.match);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-[44px] items-center rounded-lg px-2 text-xs font-medium transition-colors sm:px-3.5 sm:text-sm',
              active
                ? 'bg-elevated text-baby'
                : 'text-muted hover:bg-surface hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={withBase('/Claudiu-Span-CV.pdf')}
        class="hidden min-h-[40px] items-center gap-1.5 rounded-lg border border-border-subtle bg-surface px-3 text-xs font-semibold text-ink transition-colors hover:border-baby hover:text-baby md:inline-flex"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        PDF CV
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-pressed="false"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-border-subtle bg-surface text-ink transition-colors hover:border-baby hover:text-baby"
        title="Switch Dark / Light theme"
      >
        <span class="theme-opt-light inline-flex items-center">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <span class="sr-only">Switch to light theme</span>
        </span>
        <span class="theme-opt-dark inline-flex items-center">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <span class="sr-only">Switch to dark theme</span>
        </span>
      </button>
    </div>
  </div>
</header>
