---
import fs from 'node:fs';
import path from 'node:path';
import { SITE, withBase } from '@/data/site';

const hasCustomPortrait = fs.existsSync(
  path.resolve(process.cwd(), 'public', 'media', 'portrait.webp'),
);
const hasHeroLoopWebm = fs.existsSync(
  path.resolve(process.cwd(), 'public', 'media', 'hero-loop.webm'),
);
const hasHeroLoopMp4 = fs.existsSync(
  path.resolve(process.cwd(), 'public', 'media', 'hero-loop.mp4'),
);
const hasHeroPoster = fs.existsSync(
  path.resolve(process.cwd(), 'public', 'media', 'hero-poster.webp'),
);
---

<!-- Single Hero Visual Signature: Photographic-faithful Portrait + Poster-first Ambient Loop (Zero Canvas 2D overlap) -->
<div
  class="bento-card relative overflow-hidden p-5 sm:p-6"
  data-hero-media
>
  {(hasHeroLoopWebm || hasHeroLoopMp4) && (
    <video
      id="hero-ambient-video"
      muted
      loop
      playsinline
      preload="none"
      width="640"
      height="480"
      poster={hasHeroPoster ? withBase('/media/hero-poster.webp') : undefined}
      data-src-webm={hasHeroLoopWebm ? withBase('/media/hero-loop.webm') : undefined}
      data-src-mp4={hasHeroLoopMp4 ? withBase('/media/hero-loop.mp4') : undefined}
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-20"
    />
  )}

  <div class="relative z-10 flex flex-col gap-5">
    <div class="flex items-center gap-4">
      <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-2xl border border-border-strong bg-elevated sm:h-24 sm:w-24">
        {hasCustomPortrait ? (
          <img
            src={withBase('/media/portrait.webp')}
            alt={`${SITE.name} portrait`}
            width="192"
            height="192"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover"
          />
        ) : (
          <svg
            viewBox="0 0 160 160"
            width="160"
            height="160"
            role="img"
            aria-label={`${SITE.name} monogram portrait slot`}
            class="h-full w-full"
          >
            <rect width="160" height="160" fill="var(--bg-elevated)" />
            <circle cx="80" cy="62" r="26" fill="var(--bg-surface)" stroke="var(--accent-primary)" stroke-width="2" />
            <path d="M36 138c6-24 22-36 44-36s38 12 44 36" fill="var(--bg-surface)" stroke="var(--accent-primary)" stroke-width="2" />
            <text x="80" y="70" text-anchor="middle" fill="var(--accent-primary)" font-family="var(--font-display)" font-size="22" font-weight="700">CȘ</text>
          </svg>
        )}
      </div>

      <div>
        <p class="font-mono text-xs uppercase tracking-wider text-baby">Engineering Snapshot</p>
        <p class="mt-1 font-display text-lg font-bold text-ink" translate="no">{SITE.name}</p>
        <p class="text-sm text-muted">{SITE.location}</p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="rounded-xl border border-border-subtle bg-elevated/80 p-3.5">
        <p class="font-display text-2xl font-bold text-baby tabular-nums sm:text-3xl">40+</p>
        <p class="mt-1 text-xs leading-snug text-muted">
          Production automation workflows delivered end to end
        </p>
      </div>
      <div class="rounded-xl border border-border-subtle bg-elevated/80 p-3.5">
        <p class="font-display text-2xl font-bold text-coral tabular-nums sm:text-3xl">~70%</p>
        <p class="mt-1 text-xs leading-snug text-muted">
          Operator review-time cut via Enterprise Agentic AI
        </p>
      </div>
    </div>

    <dl class="divide-y divide-border-subtle text-sm">
      <div class="flex items-center justify-between gap-2 py-2">
        <dt class="text-muted">Primary Focus</dt>
        <dd class="font-medium text-ink">Applied AI &amp; RPA</dd>
      </div>
      <div class="flex items-center justify-between gap-2 py-2">
        <dt class="text-muted">Employer</dt>
        <dd class="font-medium text-ink" translate="no">Betfair Romania</dd>
      </div>
      <div class="flex items-center justify-between gap-2 py-2">
        <dt class="text-muted">Side Venture</dt>
        <dd class="font-medium text-ink">
          <a href={SITE.quadyxUrl} target="_blank" rel="noopener noreferrer" translate="no" class="text-baby underline-offset-4 hover:underline">
            QUADYX
          </a>
        </dd>
      </div>
      <div class="flex items-center justify-between gap-2 py-2">
        <dt class="text-muted">Credentials</dt>
        <dd class="font-medium text-ink">MSc UTCN · AWS AIF-C01</dd>
      </div>
    </dl>
  </div>
</div>

<!-- Post-LCP ambient video attachment with prefers-reduced-motion, saveData, IntersectionObserver & visibilitychange gates -->
<script is:inline>
  (() => {
    const video = document.getElementById('hero-ambient-video');
    if (!video) return;
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = Boolean(navigator.connection && navigator.connection.saveData);
    let attached = false;

    function attachAndPlay() {
      if (mq.matches || saveData) {
        video.removeAttribute('autoplay');
        video.pause();
        return;
      }
      if (!attached) {
        const webm = video.getAttribute('data-src-webm');
        const mp4 = video.getAttribute('data-src-mp4');
        if (webm) {
          const s1 = document.createElement('source');
          s1.src = webm;
          s1.type = 'video/webm';
          video.appendChild(s1);
        }
        if (mp4) {
          const s2 = document.createElement('source');
          s2.src = mp4;
          s2.type = 'video/mp4';
          video.appendChild(s2);
        }
        video.load();
        attached = true;
      }
      video.play().catch(() => {
        // Ignore autoplay promise rejection on power-saving browsers
      });
    }

    window.addEventListener('load', attachAndPlay, { once: true });
    mq.addEventListener('change', (e) => {
      if (e.matches) {
        video.removeAttribute('autoplay');
        video.pause();
      } else {
        attachAndPlay();
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') video.pause();
      else attachAndPlay();
    });
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry) return;
        if (entry.isIntersecting) attachAndPlay();
        else video.pause();
      });
      obs.observe(video);
    }
  })();
</script>
