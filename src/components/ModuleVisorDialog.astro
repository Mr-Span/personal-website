---
import type { ShowcaseModule } from '@/data/showcase-modules';
import { SITE } from '@/data/site';

interface Props {
  modules: ShowcaseModule[];
}

const { modules } = Astro.props;
---

<!-- Native Top-Layer Frosted Inspection Visor (<dialog closedby="any">) with Machined Top Gripper Clamp + Apple Sliding Segmented Control -->
<dialog
  id="module-visor"
  closedby="any"
  class="dialog-visor"
  aria-labelledby="visor-title"
  data-modules={JSON.stringify(modules)}
  data-email={SITE.email}
>
  <!-- Physical Top Gripper Clamp Receiver -->
  <div class="visor-clamp" aria-hidden="true">
    <span class="visor-clamp-led"></span>
    <span class="visor-clamp-bar"></span>
  </div>

  <div class="flex shrink-0 items-center justify-between gap-3 rounded-t-[18px] border-b border-hairline px-6 pb-3.5 pt-4.5 sm:px-7">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="hw-eyebrow text-ink">
        <span class="px-beacon shadow-[0_0_0_2px_var(--vermilion-tint)]" aria-hidden="true"></span>
        <span>LOCKED IN VISOR</span>
      </span>
      <span
        id="visor-cat"
        class="rounded-[3px] bg-[var(--vermilion-tint)] px-2 py-0.5 font-mono text-[10.5px] font-medium uppercase tracking-[0.08em] text-vermilion"
      >
        PROFILE
      </span>
      <span class="font-mono text-[11px] text-muted tabular-nums" id="visor-counter">1 / 6</span>
    </div>

    <div class="flex items-center gap-1.5">
      <button
        id="visor-prev"
        type="button"
        aria-label="Previous module"
        title="Previous module (←)"
        class="inline-flex h-8 w-8 items-center justify-center rounded-[7px] border border-strong bg-surface font-mono text-xs text-ink shadow-[var(--shadow-bevel)] transition-colors hover:border-ink"
      >
        <span aria-hidden="true">&larr;</span>
      </button>
      <button
        id="visor-next"
        type="button"
        aria-label="Next module"
        title="Next module (→)"
        class="inline-flex h-8 w-8 items-center justify-center rounded-[7px] border border-strong bg-surface font-mono text-xs text-ink shadow-[var(--shadow-bevel)] transition-colors hover:border-ink"
      >
        <span aria-hidden="true">&rarr;</span>
      </button>
      <form method="dialog">
        <button
          id="visor-close"
          type="submit"
          class="inline-flex h-8 items-center gap-1 rounded-[7px] border border-strong bg-surface px-2.5 font-mono text-xs font-medium text-ink shadow-[var(--shadow-bevel)] transition-colors hover:border-ink"
        >
          Close <span aria-hidden="true">&times;</span>
        </button>
      </form>
    </div>
  </div>

  <div id="visor-panel-body" class="min-h-0 flex-1 overflow-y-auto rounded-b-[18px] px-6 pb-6 pt-5 transition-opacity duration-120 sm:px-7">
    <h2 id="visor-title" class="font-display text-2xl font-bold tracking-[-0.03em] text-ink sm:text-[28px]">
      Module Title
    </h2>

    <!-- Apple-Style Sliding Segmented Control (Recruiter Scan <-> Engineer Deep Dive) -->
    <div
      id="segmented-control"
      data-active="recruiter"
      role="group"
      aria-label="Inspection audience lens"
      class="segmented-control mt-3.5"
    >
      <div class="segmented-thumb" aria-hidden="true"></div>
      <button
        id="lens-recruiter"
        type="button"
        aria-pressed="true"
        class="relative z-[1] inline-flex items-center justify-center gap-2 rounded-[7px] px-3 py-1.5 text-xs font-semibold transition-colors"
      >
        <span class="seg-dot h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        <span>Recruiter Scan</span>
      </button>
      <button
        id="lens-engineer"
        type="button"
        aria-pressed="false"
        class="relative z-[1] inline-flex items-center justify-center gap-2 rounded-[7px] px-3 py-1.5 text-xs font-semibold transition-colors"
      >
        <span class="seg-dot h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
        <span>Engineer Deep Dive</span>
      </button>
    </div>

    <!-- 3-Column Tactile Metric Strip -->
    <dl
      id="visor-stats"
      class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3"
    ></dl>

    <!-- Dynamic Summary & Highlights -->
    <div id="visor-copy" class="mt-4 space-y-2.5"></div>

    <!-- Clean Stack Chips -->
    <div id="visor-stack" class="mt-4 flex flex-wrap gap-1.5 font-mono"></div>

    <!-- Primary MPA Deep-Link & Direct Actions -->
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-4">
      <div id="visor-actions" class="flex flex-wrap items-center gap-2"></div>
      <span class="hidden font-mono text-[11px] text-muted sm:inline">
        &larr; / &rarr; switch &middot; Esc release
      </span>
    </div>
    <p id="visor-status" role="status" aria-live="polite" class="sr-only"></p>
  </div>
</dialog>

<style>
  #lens-recruiter[aria-pressed='true'],
  #lens-engineer[aria-pressed='true'] {
    color: var(--ink-primary);
  }

  #lens-recruiter[aria-pressed='false'],
  #lens-engineer[aria-pressed='false'] {
    color: var(--ink-muted);
  }

  #lens-recruiter[aria-pressed='true'] .seg-dot {
    background: var(--accent-vermilion);
  }

  #lens-engineer[aria-pressed='true'] .seg-dot {
    background: var(--accent-tech);
  }

  #lens-recruiter[aria-pressed='false'] .seg-dot,
  #lens-engineer[aria-pressed='false'] .seg-dot {
    background: var(--border-interactive);
  }
</style>

<script>
  import type { ShowcaseModule } from '@/data/showcase-modules';
  import { attachLightDismissFallback } from '@/lib/dialog-utils';

  type CobotWindow = Window & {
    __openModuleVisor?: (i: number) => void;
    __cobotPickModule?: (idx: number, cb: (i: number) => void) => void;
    __cobotReleaseModule?: () => void;
    __cobotSetActiveSlot?: (idx: number) => void;
  };

  const dialog = document.getElementById('module-visor') as HTMLDialogElement | null;
  if (dialog) {
    attachLightDismissFallback(dialog);

    const modules: ShowcaseModule[] = JSON.parse(dialog.dataset.modules || '[]');
    const emailAddress = dialog.dataset.email || 'clauxspan2002@gmail.com';
    const catEl = document.getElementById('visor-cat');
    const counterEl = document.getElementById('visor-counter');
    const titleEl = document.getElementById('visor-title');
    const statsEl = document.getElementById('visor-stats');
    const copyEl = document.getElementById('visor-copy');
    const stackEl = document.getElementById('visor-stack');
    const actionsEl = document.getElementById('visor-actions');
    const bodyEl = document.getElementById('visor-panel-body');
    const statusEl = document.getElementById('visor-status');
    const segCtrl = document.getElementById('segmented-control');
    const btnPrev = document.getElementById('visor-prev');
    const btnNext = document.getElementById('visor-next');
    const btnRecruiter = document.getElementById('lens-recruiter');
    const btnEngineer = document.getElementById('lens-engineer');

    let currentIdx = 0;
    let lens: 'recruiter' | 'engineer' = 'recruiter';
    const win = window as unknown as CobotWindow;

    function renderModule(idx: number, animateBody = false) {
      const mod = modules[idx];
      if (!mod) return;
      currentIdx = idx;

      const updateDOM = () => {
        if (catEl) catEl.textContent = mod.category;
        if (counterEl) counterEl.textContent = `${idx + 1} / ${modules.length}`;
        if (titleEl) titleEl.textContent = mod.title;
        if (segCtrl) segCtrl.setAttribute('data-active', lens);

        if (statsEl) {
          statsEl.textContent = '';
          mod.stats.forEach((s) => {
            const cell = document.createElement('div');
            cell.className = 'rounded-[10px] border border-hairline bg-surface px-3.5 py-3 shadow-[var(--inner-highlight)]';
            const dt = document.createElement('dt');
            dt.className = 'font-mono text-[10.5px] font-semibold uppercase tracking-[0.09em] text-muted';
            dt.textContent = s.label;
            const dd = document.createElement('dd');
            dd.className = 'mt-1 font-mono text-[13px] font-semibold text-ink tabular-nums';
            dd.textContent = s.value;
            cell.append(dt, dd);
            statsEl.appendChild(cell);
          });
        }

        const lensData = lens === 'recruiter' ? mod.recruiter : mod.engineer;
        if (copyEl) {
          copyEl.textContent = '';
          const p = document.createElement('p');
          p.className = 'text-[14.5px] leading-[1.65] text-ink';
          p.textContent = lensData.summary;
          const ul = document.createElement('ul');
          ul.className = 'space-y-2 text-[13.5px] text-ink-secondary';
          lensData.bullets.forEach((b) => {
            const li = document.createElement('li');
            li.className = 'relative pl-4 leading-relaxed';
            const chev = document.createElement('span');
            chev.className = 'absolute left-0 top-0 font-bold text-vermilion';
            chev.setAttribute('aria-hidden', 'true');
            chev.textContent = '›';
            li.append(chev, document.createTextNode(b));
            ul.appendChild(li);
          });
          copyEl.append(p, ul);
        }

        if (stackEl) {
          stackEl.textContent = '';
          mod.stack.forEach((tech) => {
            const chip = document.createElement('span');
            chip.className = 'rounded-md border border-hairline bg-surface px-2.5 py-1 text-[11.5px] font-medium text-ink shadow-[var(--inner-highlight)]';
            chip.textContent = tech;
            stackEl.appendChild(chip);
          });
        }

        btnRecruiter?.setAttribute('aria-pressed', String(lens === 'recruiter'));
        btnEngineer?.setAttribute('aria-pressed', String(lens === 'engineer'));

        if (actionsEl) {
          actionsEl.textContent = '';
          mod.actions.forEach((act) => {
            const cls = act.primary ? 'cta-anodized btn-press' : 'cta-secondary-bevel btn-press';
            if (act.type === 'route' || act.type === 'external') {
              const a = document.createElement('a');
              a.className = cls;
              a.href = act.href || '#';
              a.textContent = act.label;
              if (act.type === 'external') {
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
              }
              actionsEl.appendChild(a);
            } else {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = cls;
              b.textContent = act.label;
              b.addEventListener('click', async () => {
                try {
                  await navigator.clipboard.writeText(emailAddress);
                  b.textContent = 'Copied ✓';
                  if (statusEl) statusEl.textContent = `Copied ${emailAddress}`;
                  window.setTimeout(() => {
                    b.textContent = act.label;
                  }, 1700);
                } catch {
                  if (statusEl) statusEl.textContent = emailAddress;
                }
              });
              actionsEl.appendChild(b);
            }
          });
        }
      };

      if (animateBody && bodyEl) {
        bodyEl.style.opacity = '0.35';
        window.setTimeout(() => {
          updateDOM();
          bodyEl.style.opacity = '1';
        }, 70);
      } else {
        updateDOM();
      }
    }

    function openVisorImmediate(idx: number) {
      renderModule(idx, false);
      if (!dialog!.open) {
        dialog!.showModal();
      }
    }

    function triggerModuleInspect(idx: number) {
      if (typeof win.__cobotPickModule === 'function' && !dialog!.open) {
        win.__cobotPickModule(idx, openVisorImmediate);
      } else {
        win.__cobotSetActiveSlot?.(idx);
        openVisorImmediate(idx);
      }
    }

    // Release 3D cartridge back to its dock slot cleanly when native <dialog> closes
    // Also clear restored focus on the station card so Esc never leaves a ghost highlight/lift behind
    const blurRestoredStationCard = () => {
      const activeEl = document.activeElement as HTMLElement | null;
      if (activeEl && activeEl.hasAttribute('data-station-index')) {
        activeEl.blur();
      }
    };
    dialog.addEventListener('close', () => {
      win.__cobotReleaseModule?.();
      blurRestoredStationCard();
      queueMicrotask(blurRestoredStationCard);
    });

    win.__openModuleVisor = triggerModuleInspect;

    // Progressive enhancement on the 6 2.5D cartridge links (middle-click / Ctrl+click still navigates directly!)
    Array.from(document.querySelectorAll('[data-station-index]')).forEach((node) => {
      const el = node as HTMLAnchorElement;
      el.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        const idx = Number(el.dataset.stationIndex || 0);
        triggerModuleInspect(idx);
      });
    });

    btnPrev?.addEventListener('click', () => {
      const next = (currentIdx - 1 + modules.length) % modules.length;
      win.__cobotSetActiveSlot?.(next);
      renderModule(next, true);
    });
    btnNext?.addEventListener('click', () => {
      const next = (currentIdx + 1) % modules.length;
      win.__cobotSetActiveSlot?.(next);
      renderModule(next, true);
    });

    btnRecruiter?.addEventListener('click', () => {
      if (lens !== 'recruiter') {
        lens = 'recruiter';
        renderModule(currentIdx, true);
      }
    });
    btnEngineer?.addEventListener('click', () => {
      if (lens !== 'engineer') {
        lens = 'engineer';
        renderModule(currentIdx, true);
      }
    });

    dialog.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.id === 'lens-recruiter' || target.id === 'lens-engineer')) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const next = (currentIdx - 1 + modules.length) % modules.length;
        win.__cobotSetActiveSlot?.(next);
        renderModule(next, true);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        const next = (currentIdx + 1) % modules.length;
        win.__cobotSetActiveSlot?.(next);
        renderModule(next, true);
      }
    });
  }
</script>
