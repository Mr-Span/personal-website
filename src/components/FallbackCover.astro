---
interface Props {
  title: string;
  tier: 'case-study' | 'showcase-card';
}

const { title, tier } = Astro.props;
const accent = tier === 'case-study' ? 'var(--accent-primary)' : 'var(--accent-signal)';
const caption = tier === 'case-study' ? 'Architecture Blueprint' : 'Project Showcase';
---

<!-- Deterministic code-generated fallback cover (zero Google AI Pro quota block) -->
<div class="relative aspect-[16/9] w-full overflow-hidden rounded-xl border border-border-subtle bg-elevated">
  <svg
    viewBox="0 0 640 360"
    width="640"
    height="360"
    aria-hidden="true"
    class="h-full w-full"
  >
    <defs>
      <pattern id={`grid-${title.replace(/[^a-zA-Z0-9]/g, '').slice(0, 12)}`} width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M 32 0 L 0 0 0 32" fill="none" stroke="var(--border-subtle)" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="640" height="360" fill="var(--bg-elevated)" />
    <rect width="640" height="360" fill={`url(#grid-${title.replace(/[^a-zA-Z0-9]/g, '').slice(0, 12)})`} opacity="0.7" />
    <circle cx="110" cy="180" r="14" fill="var(--bg-surface)" stroke={accent} stroke-width="2.5" />
    <circle cx="320" cy="135" r="16" fill="var(--bg-surface)" stroke={accent} stroke-width="2.5" />
    <circle cx="320" cy="235" r="14" fill="var(--bg-surface)" stroke="var(--accent-contrast)" stroke-width="2.5" />
    <circle cx="530" cy="180" r="16" fill="var(--bg-surface)" stroke="var(--accent-signal)" stroke-width="2.5" />
    <path d="M 124 180 C 200 180, 230 135, 304 135" fill="none" stroke={accent} stroke-width="2" />
    <path d="M 124 180 C 200 180, 230 235, 306 235" fill="none" stroke="var(--accent-contrast)" stroke-width="1.8" stroke-dasharray="6 5" />
    <path d="M 336 135 C 410 135, 440 180, 514 180" fill="none" stroke={accent} stroke-width="2" />
    <path d="M 334 235 C 410 235, 440 180, 514 180" fill="none" stroke="var(--accent-signal)" stroke-width="1.8" />
  </svg>
  <span class="absolute bottom-3 left-3 rounded-md border border-border-strong bg-surface/90 px-2.5 py-1 font-mono text-[11px] font-medium text-muted">
    {caption}
  </span>
</div>
