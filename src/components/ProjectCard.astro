---
import type { CollectionEntry } from 'astro:content';
import FallbackCover from './FallbackCover.astro';
import { withBase } from '@/data/site';

interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { data } = project;
const slug = project.id.replace(/\.mdx$/, '');

const visibilityLabel =
  data.visibility === 'anonymized'
    ? data.isSideVenture
      ? 'Side Venture · Architecture Summary'
      : 'Anonymized Enterprise Case Study'
    : data.visibility === 'public'
      ? data.liveUrl
        ? 'Public Repo + Live'
        : 'Public Repo'
      : 'Client / Private Repo';
---

<article
  class="bento-card bento-card-interactive flex flex-col justify-between gap-4 p-5"
  data-project-card
  data-categories={data.category.join(' ')}
>
  <div class="flex flex-col gap-3.5">
    {!compact && (
      data.coverAsset ? (
        <div class="aspect-[16/9] w-full overflow-hidden rounded-xl border border-border-subtle bg-elevated">
          <img
            src={withBase(data.coverAsset)}
            alt={`${data.title} visual cover`}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
      ) : (
        <FallbackCover title={data.title} tier={data.tier} />
      )
    )}

    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
      <span class="font-mono font-medium text-baby">{visibilityLabel}</span>
      <span class="rounded-md border border-border-subtle bg-elevated px-2 py-0.5 font-mono text-ink tabular-nums">
        {data.outcomeBadge}
      </span>
    </div>

    <h3 class="font-display text-lg font-bold text-ink">
      {data.tier === 'case-study' ? (
        <a
          href={withBase(`/projects/${slug}/`)}
          class="transition-colors hover:text-baby"
        >
          {data.title}
        </a>
      ) : (
        data.title
      )}
    </h3>

    <p class="text-sm leading-relaxed text-muted">{data.summary}</p>
  </div>

  <div class="flex flex-col gap-3 border-t border-border-subtle pt-3.5">
    <ul class="flex flex-wrap gap-1.5" aria-label={`Stack used in ${data.title}`}>
      {data.stack.slice(0, 6).map((tech) => (
        <li class="rounded-md border border-border-subtle bg-elevated px-2 py-0.5 font-mono text-xs text-muted">
          {tech}
        </li>
      ))}
    </ul>

    <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
      {data.tier === 'case-study' && (
        <a
          href={withBase(`/projects/${slug}/`)}
          class="inline-flex min-h-[36px] items-center gap-1.5 text-baby underline-offset-4 hover:underline"
        >
          Inspect Architecture &amp; Case Study
          <span aria-hidden="true">&rarr;</span>
        </a>
      )}
      {data.liveUrl && (
        <a
          href={data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[36px] items-center gap-1 text-ink underline-offset-4 hover:text-baby hover:underline"
        >
          Live Site
          <span aria-hidden="true">&#8599;</span>
        </a>
      )}
      {data.visibility === 'public' && data.repoUrl && (
        <a
          href={data.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[36px] items-center gap-1 text-muted underline-offset-4 hover:text-ink hover:underline"
        >
          Source Repo
          <span aria-hidden="true">&#8599;</span>
        </a>
      )}
    </div>
  </div>
</article>
